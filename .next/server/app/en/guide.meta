{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/guide/layout,_N_T_/[locale]/guide/page,_N_T_/en/guide,siteSettings,siteText,content,form"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/guide/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  },
  "routeCache": {
    "key": "/route-cache/APP_PAGE/571f10ccc74071f209ffb85d79a357f15b6fa49ff3d4ba40c5a33e57e422ecaa/$/en/guide",
    "owner": {
      "kind": "APP_PAGE",
      "sourceRoute": "/[locale]/guide/page"
    },
    "isFallback": false
  }
}