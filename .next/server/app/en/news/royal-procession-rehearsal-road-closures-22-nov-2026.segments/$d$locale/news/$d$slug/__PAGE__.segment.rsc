19:["$","$L35","2",{"attrs":{"items":[{"label":{"en":"Roads around Sanam Luang closed, morning","th":"ปิดถนนรอบสนามหลวง ช่วงเช้า"},"detail":{"en":"16 roads, including Phra Chan, Na Phra That and Maharat","th":"16 ถนน รวมถนนพระจันทร์ หน้าพระธาตุ และมหาราช"},"endsAt":"2026-11-22T05:00:00.000Z","startsAt":"2026-11-21T23:00:00.000Z"},{"label":{"en":"Procession 1: Dusit Maha Prasat Throne Hall to Wat Pho","th":"ริ้วขบวนที่ 1: พระที่นั่งดุสิตมหาปราสาท ไป วัดพระเชตุพนฯ"},"detail":{"en":"Maharat, Thai Wang","th":"ถนนมหาราช, ท้ายวัง"},"endsAt":"2026-11-22T01:00:00.000Z","startsAt":"2026-11-21T23:45:00.000Z"},{"label":{"en":"Procession 2: Wat Pho to Sanam Luang","th":"ริ้วขบวนที่ 2: วัดพระเชตุพนฯ ไป ท้องสนามหลวง"},"detail":{"en":"Sanam Chai, Ratchadamnoen Nai","th":"ถนนสนามไชย, ราชดำเนินใน"},"endsAt":"2026-11-22T03:00:00.000Z","startsAt":"2026-11-22T00:50:00.000Z"},{"label":{"en":"Procession 3: around the royal crematorium","th":"ริ้วขบวนที่ 3: วนรอบพระเมรุมาศ"},"detail":{"en":"Sanam Luang","th":"ท้องสนามหลวง"},"endsAt":"2026-11-22T04:00:00.000Z","startsAt":"2026-11-22T03:00:00.000Z"},{"label":{"en":"Procession 3: march past Wat Mahathat","th":"ริ้วขบวนที่ 3: เดินแถวหน้าวัดพระธาตุ"},"detail":{"en":"Na Phra That, Na Phra Lan, Sanam Chai, Kanlayana Maitri","th":"ถนนหน้าพระธาตุ, หน้าพระลาน, สนามไชย, กัลยาณไมตรี"},"endsAt":"2026-11-22T04:30:00.000Z","startsAt":"2026-11-22T03:45:00.000Z"},{"label":{"en":"Roads around Sanam Luang closed, afternoon and evening","th":"ปิดถนนรอบสนามหลวง ช่วงบ่ายถึงค่ำ"},"detail":{"en":"16 roads. Na Phra That stays closed; Phra Chan and Maharat are open","th":"16 ถนน ถนนหน้าพระธาตุยังปิด ถนนพระจันทร์และมหาราชใช้ได้"},"endsAt":"2026-11-22T13:30:00.000Z","startsAt":"2026-11-22T08:00:00.000Z"},{"label":{"en":"Procession 6: Ratchini Road","th":"ริ้วขบวนที่ 6: ถนนราชินี"},"detail":{"en":"Ratchini","th":"ถนนราชินี"},"endsAt":"2026-11-22T09:30:00.000Z","startsAt":"2026-11-22T08:00:00.000Z"},{"label":{"en":"Procession 6: Saranrom Park to the Territorial Defence Command","th":"ริ้วขบวนที่ 6: สวนสราญรมย์ ไป นรด."},"detail":{"en":"Charoen Krung","th":"ถนนเจริญกรุง"},"endsAt":"2026-11-22T10:00:00.000Z","startsAt":"2026-11-22T09:30:00.000Z"},{"label":{"en":"Procession 6: Territorial Defence Command to the Grand Palace","th":"ริ้วขบวนที่ 6: นรด. ไป พระบรมมหาราชวัง"},"detail":{"en":"Sanam Chai, Na Phra Lan","th":"ถนนสนามไชย, หน้าพระลาน"},"endsAt":"2026-11-22T10:30:00.000Z","startsAt":"2026-11-22T10:00:00.000Z"},{"label":{"en":"Procession 6: Grand Palace to Wat Ratchabophit","th":"ริ้วขบวนที่ 6: พระบรมมหาราชวัง ไป วัดราชบพิธฯ"},"detail":{"en":"Na Phra Lan, Kanlayana Maitri, Atsadang","th":"ถนนหน้าพระลาน, กัลยาณไมตรี, อัษฎางค์"},"endsAt":"2026-11-22T11:30:00.000Z","startsAt":"2026-11-22T10:45:00.000Z"},{"label":{"en":"Procession 6: Wat Ratchabophit to Wat Bowonniwet","th":"ริ้วขบวนที่ 6: วัดราชบพิธฯ ไป วัดบวรนิเวศฯ"},"detail":{"en":"Atsadang, Ratchabophit, Fueang Nakhon, Bamrung Mueang, Kanlayana Maitri, Sanam Chai, Ratchadamnoen Nai, Ratchadamnoen Klang, Dinso, Phra Sumen","th":"ถนนอัษฎางค์, ราชบพิธ, เฟื่องนคร, บำรุงเมือง, กัลยาณไมตรี, สนามไชย, ราชดำเนินใน, ราชดำเนินกลาง, ดินสอ, พระสุเมรุ"},"endsAt":"2026-11-22T12:00:00.000Z","startsAt":"2026-11-22T11:30:00.000Z"},{"label":{"en":"Procession 6: Wat Bowonniwet to Royal Thai Army Headquarters","th":"ริ้วขบวนที่ 6: วัดบวรนิเวศฯ ไป บก.ทบ."},"detail":{"en":"Prachathipatai","th":"ถนนประชาธิปไตย"},"endsAt":"2026-11-22T13:00:00.000Z","startsAt":"2026-11-22T12:00:00.000Z"}],"title":{"en":"Where things are now","th":"ตอนนี้ถึงไหนแล้ว"}},"locale":"en","headingLevel":2}]
