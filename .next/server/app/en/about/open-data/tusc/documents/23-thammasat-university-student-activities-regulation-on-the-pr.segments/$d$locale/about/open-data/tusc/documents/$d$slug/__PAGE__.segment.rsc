52:["$","p","31",{"id":"clause-11","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 11"}]]}],["$","$3","1",{"children":" ให้สภานักศึกษา ระดับศูนย์ ติดตามและตรวจสอบการดำเนินกิจกรรมนักศึกษาของคณะกรรมการบริหารองค์การนักศึกษา ระดับศูนย์ คณะกรรมการนักศึกษาประจำคณะ ชุมนุม และกลุ่มอิสระที่ดำเนินการอยู่ภายในศูนย์การศึกษาเดียวกับสภานักศึกษา ระดับศูนย์ นั้น"}]]]}]
53:["$","p","32",{"id":"clause-12","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 12"}]]}],["$","$3","1",{"children":" กรณีพบการกระทำหรือได้รับคำร้องว่ามีการดำเนินกิจกรรมนักศึกษาอันอาจเข้าข่ายฝ่าฝืนระเบียบนี้ ให้สภานักศึกษา หรือสภานักศึกษา ระดับศูนย์ แล้วแต่กรณี ออกคำสั่งเรียกผู้ดำเนินกิจกรรมนักศึกษาเข้าชี้แจงข้อเท็จจริง รวมถึงอาจเรียกบุคคลอื่นมาชี้แจงข้อเท็จจริงในฐานะพยาน ต่อที่ประชุมสภานักศึกษา หรือสภานักศึกษา ระดับศูนย์ เพื่อพิจารณาว่าเป็นการฝ่าฝืนความในข้อ 6 หรือกระทำผิดระเบียบอย่างร้ายแรงตามข้อ 7 หรือไม่"}]]]}]
