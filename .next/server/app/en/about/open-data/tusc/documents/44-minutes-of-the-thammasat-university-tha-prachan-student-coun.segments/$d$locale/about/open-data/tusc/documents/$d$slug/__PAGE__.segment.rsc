97:["$","p","87",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"คุณรัชพล สังวรธรรม ประธานสภานักศึกษาฯ ท่าพระจันทร์ กล่าวว่า มีผู้ใดจะคัดค้านหรือไม่ หากไม่มีตนจะวินิจฉัยว่าเป็นมติของสภานักศึกษาฯ ท่าพระจันทร์ โดยปริยาย ให้มีการพิจารณาร่างระเบียบดังกล่าวโดยกรรมาธิการเต็มสภา โดยจะดำเนินการพิจารณาร่างระเบียบต่อไปพร้อมกันทีละข้อ จากนั้นกล่าวต่อว่า"}]]]}]
