bd:["$","p","153",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"กรณีที่มีการแต่งตั้งกรรมาธิการให้ดำรงตำแหน่งรองประธานมากกว่าหนึ่งคน หรือตำแหน่งอื่นตามวรรคสอง ประธานคณะกรรมาธิการต้องแจ้งให้ประธานสภาและที่ประชุมคณะกรรมาธิการทราบถึงความจำเป็นดังกล่าว"}]]]}]
be:["$","p","154",{"id":"clause-65","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ ๖๕"}]]}],["$","$3","1",{"children":" เมื่อไม่มีผู้ดำรงตำแหน่งประธานคณะกรรมาธิการ หรือมีแต่ไม่สามารถปฏิบัติหน้าที่ได้ ให้รองประธานคณะกรรมาธิการเป็นผู้ปฏิบัติหน้าที่แทนประธานคณะกรรมาธิการ"}]]]}]
bf:["$","p","155",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในกรณีที่มีรองประธานคณะกรรมาธิการหลายคน ให้รองประธานคณะกรรมาธิการคนที่หนึ่งเป็นผู้ปฏิบัติหน้าที่แทนประธานคณะกรรมาธิการ หากรองประธานคณะกรรมาธิการคนที่หนึ่งไม่สามารถปฏิบัติหน้าที่ได้ ให้รองประธานคณะกรรมาธิการลำดับต่อไปเป็นผู้ปฏิบัติหน้าที่แทนประธานคณะกรรมาธิการ"}]]]}]
c0:["$","p","156",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในกรณีไม่มีผู้ปฏิบัติหน้าที่ตามวรรคสอง ให้กรรมาธิการคนหนึ่งเสนอชื่อกรรมาธิการคนใด เพื่อเป็นผู้ปฏิบัติหน้าที่แทนประธานคณะกรรมาธิการ เมื่อที่ประชุมคณะกรรมาธิการมีมติเห็นชอบด้วยคะแนนเสียงเกินกว่ากึ่งหนึ่งของจำนวนกรรมาธิการเท่าที่มีอยู่"}]]]}]
c1:["$","p","157",{"id":"clause-66","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ ๖๖"}]]}],["$","$3","1",{"children":" เมื่อการเสนอแต่งตั้งอนุกรรมาธิการ ให้มีประกาศสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ เรื่อง การแต่งตั้งอนุกรรมาธิการ ภายในสิบห้าวัน นับตั้งแต่มีการเสนอชื่อ"}]]]}]
