c4:["$","p","160",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"อนุกรรมาธิการมีสิทธิเข้าประชุมสภา แต่ไม่มีสิทธิลงคะแนนเสียงในเรื่องต่าง ๆ ของสภา และหากประธานคณะกรรมาธิการเห็นสมควรจะไม่ให้อนุกรรมาธิการเข้าประชุมก็ได้"}]]]}]
c5:["$","p","161",{"id":"clause-67","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ ๖๗"}]]}],["$","$3","1",{"children":" คณะกรรมาธิการมีอำนาจตั้งคณะอนุกรรมาธิการเพื่อพิจารณาปัญหาอันอยู่ในอำนาจหน้าที่ของคณะกรรมาธิการ แล้วรายงานคณะกรรมาธิการภายในเวลาที่คณะกรรมาธิการกำหนด"}]]]}]
c6:["$","p","162",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในกรณีที่คณะอนุกรรมาธิการกระทำกิจการ พิจารณาสอบสวน หรือศึกษาเรื่องใดไม่เสร็จในเวลาที่กำหนด ให้ประธานคณะอนุกรรมาธิการขออนุญาตขยายเวลาต่อที่ประชุมคณะกรรมาธิการ"}]]]}]
c7:["$","p","163",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"คณะอนุกรรมาธิการแต่ละคณะประกอบด้วยอนุกรรมาธิการมีจำนวนไม่เกินเจ็ดคน โดยให้ตั้งจากบุคคลที่เป็นกรรมาธิการในคณะนั้นมีจำนวนไม่น้อยกว่าสามคนของจำนวนอนุกรรมาธิการทั้งหมดและประธานคณะอนุกรรมาธิการต้องเป็นกรรมาธิการ จำนวนนอกจากนั้นให้ที่ประชุมคณะกรรมาธิการเลือกจากรายชื่อกรรมาธิการเสนอ"}]]]}]
c8:["$","blockquote","164",{"className":"m-0 flex flex-col gap-[var(--space-3)] border-l-4 border-line-strong pl-[var(--space-4)] text-ink-900","children":[["$","p","0",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"[ภาพ: ข้อความ “คณะอนุกรรมาธิการแต่ละคณะประกอบด้วยอนุกรรมาธิการมีจำนวนไม่เกินเจ็ดค” (ต้นวรรคสามของข้อ ๖๗) มีการไฮไลต์สีเหลืองในต้นฉบับ]"}]]]}]]}]
c9:["$","p","165",{"id":"clause-68","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ ๖๘"}]]}],["$","$3","1",{"children":" เมื่อคณะกรรมาธิการสามัญได้กระทำกิจการ พิจารณาสอบสวน หรือศึกษาเรื่องใด ๆ ตามอำนาจหน้าที่หรือตามที่สภามอบหมาย ให้คณะกรรมาธิการสามัญรายงานให้ประธานสภาทราบ ในการกระทำกิจการ พิจารณาสอบสวน หรือศึกษาเรื่องใด ๆ ต้องไม่เป็นเรื่องซ้ำซ้อนกับคณะกรรมาธิการอื่น  ในกรณีที่การกระทำนั้นเกี่ยวข้องกัน ให้เป็นหน้าที่ของประธานสภาที่จะต้องดำเนินการให้คณะกรรมาธิการสามัญที่เกี่ยวข้องกันทุกคณะร่วมกันดำเนินการ"}]]]}]
ca:["$","p","166",{"id":"clause-69","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ ๖๙"}]]}],["$","$3","1",{"children":" เมื่อคณะกรรมาธิการได้กระทำกิจการ พิจารณาสอบสวน หรือศึกษาเรื่องใด ๆ เสร็จสิ้นแล้ว ให้รายงานต่อสภา โดยแจ้งให้ประธานสภาทราบ เพื่อบรรจุเข้าระเบียบวาระการประชุมตามข้อ ๑๓ (๔)"}]]]}]
cb:["$","p","167",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในที่ประชุมสภา คณะกรรมาธิการมีสิทธิแถลง ชี้แจง หรือแก้ไขเพิ่มเติมเกี่ยวกับการกระทำดังกล่าวในวรรคหนึ่ง ในการนี้ คณะกรรมาธิการอาจมอบหมายให้บุคคลใดแถลงหรือชี้แจงแทนก็ได้ เมื่อได้รับอนุญาตจากประธาน"}]]]}]
