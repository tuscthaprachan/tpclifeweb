82:["$","p","60",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"สภานักศึกษาและองค์การนักศึกษาที่ต้องปฏิบัติงานร่วมกัน ทำให้สามารถพิจารณาดำเนินการออกประกาศและสั่งยุติไปถึงผู้ที่ดำเนินกิจกรรมนั้น ๆ ได้โดยมิต้องผ่านกระบวนการเข้าสู่สภานักศึกษาระดับศูนย์"}]]]}]
83:["$","p","61",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณรัชพล สังวรธรรม ประธานในที่ประชุม กล่าวว่า มีท่านใดจะอภิปรายถึงการจัดตั้งคณะกรรมาธิการต่อหรือไม่"}]]]}]
bc:Tc75,คุณภควัต อินทพรโสภิต สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีนิว ทีพีซี กล่าวว่า ตนมีความประสงค์ที่จะแสดงจุดยืนในการจัดตั้งคณะกรรมาธิการวิสามัญควบคุมและตรวจสอบการดำเนินกิจกรรมอันมีลักษณะเข้าข่ายโซตัส การใช้อำนาจนิยม และการเลือกปฏิบัติทางความงาม ตามที่คุณศุภชัย นาคเจือทอง ได้เสนอญัตติพิจารณาข้างต้น ตนมองว่าการกระทำที่เข้าข่ายการโซตัสนั้นเป็นสิ่งที่ไม่ควรเกิดขึ้น เพราะไม่คำนึงและละเมิดสิทธิมนุษยชน ซึ่งเป็นหลักสากลที่ทุกคนควรจะทราบและเคารพ แต่มีกลุ่มนักศึกษาบางกลุ่มที่เพิกเฉยต่อหลักสากล แม้ตนจะศึกษาในมหาวิทยาลัยที่ยึดถือเรื่องสิทธิและเสรีภาพมากที่สุดในประเทศไทย การกระทำดังกล่าวทำให้ตนและคณะรับไม่ได้เป็นอย่างยิ่ง รวมถึงกรณีสิทธิพิเศษทางความงามที่ยังคงมีอยู่ในสังคมปัจจุบันและเกิดขึ้นในมหาวิทยาลัยธรรมศาสตร์ ตนมีความเชื่อว่าสภานักศึกษาฯ ท่าพระจันทร์ ในที่ประชุมและเพื่อน ๆ นักศึกษาที่ไม่เห็นชอบต่อเหตุการณ์เช่นนี้ และมีความประสงค์ที่จะยกระดับพัฒนามหาวิทยาลัยให้สิ่งเหล่านี้หมดไป ให้มหาวิทยาลัยธรรมศาสตร์มีจุดยืนที่ชัดเจนเพื่อการขับเคลื่อนสังคมให้ก้าวหน้าดั่งที่มักกล่าวเสมอมา ท้ายที่สุดขอเน้นย้ำว่าตนและคณะสนับสนุนการจัดตั้งคณะกรรมาธิการวิสามัญนี้เป็นอย่างยิ่ง84:["$","p","62",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"$bc"}]]]}]
bd:Tc09,คุณอนุชิต ไตรทิพย์ สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีไลฟ์ ท่าพระจันทร์ กล่าวว่า ตนเชื่อว่ากรรมาธิการจะมีประสิทธิภาพในการดำเนินงานในส่วนพิทักษ์สิทธิ์นักศึกษาดียิ่งขึ้น และเชื่อว่ากระบวนการในการแก้ปัญหาโซตัสที่จะได้ผลมากที่สุด นอกเหนือจากกฎระเบียบต้องมีกระบวนการในการตรวจสอบและพิจารณา ให้กระบวนการเหล่านี้มีประสิทธิผลมากขึ้น จากการดำเนินงานและจากการแก้ปัญหาเรื่องโซตัส ไม่ว่าจะเป็นเรื่องโซตัสในคณะก็ดี หรือหน่วยงานที่ใหญ่ขึ้นเองก็ดี และตนเชื่อว่าทุกวันนี้ยังคงมีการโซตัสอยู่ ตนมีความคิดเห็นว่าสภานักศึกษา ท่าพระจันทร์ จะมีฉันทามติคิดเห็นตรงกันในการจัดการปัญหาเรื่องโซตัส และการเลือกปฏิบัติด้วยสิทธิเพศทางความงาม ประเด็นนี้เป็นเรื่องสำคัญที่ควรจะจัดการปัญหา และตนเชื่อว่ากรรมาธิการนี้จะเป็นส่วนสำคัญในการผลักดันการแก้ปัญหาเรื่องโซตัสและการเลือกปฏิบัติด้วยสิทธิเพศทางความงามในมหาวิทยาลัยธรรมศาสตร์ ตนเองในฐานะพรรครีไลฟ์ ท่าพระจันทร์ พร้อมสนับสนุนในประเด็นนี้อย่างเข้มแข็ง และเชื่อว่าปัญหานี้จะหายไปด้วยการร่วมมือของทั้งสองพรรคในสภานักศึกษาฯ ท่าพระจันทร์ ไม่ว่าเพื่อน ๆ ในมหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ที่ให้ความร่วมมือก็ดี85:["$","p","63",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"$bd"}]]]}]
86:["$","p","64",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 10 of the original]"}]
87:["$","p","65",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คณะกรรมาธิการก็ดี และฝากให้เพื่อนสมาชิกช่วยกันผลักดันกรรมาธิการนี้ให้ดำเนินงานได้อย่างราบรื่นมากยิ่งขึ้น ตนในฐานะพรรครีไลฟ์พร้อมสนับสนุนข้อเสนอของพรรครีนิว ทีพีซี อย่างเต็มที่"}]]]}]
88:["$","p","66",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณรัชพล สังวรธรรม ประธานในที่ประชุมกล่าวขอบคุณ คุณอนุชิต ไตรทิพย์ สำหรับจุดยืน และกล่าวว่า มีผู้ใดต้องการอภิปรายเพิ่มเติมหรือไม่"}]]]}]
89:["$","p","67",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณศุภชัย นาคเจือทอง สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีนิว ทีพีซี กล่าวอภิปรายเพิ่มเติมในฐานะผู้เสนอ ว่า ในปีพุทธศักราช 2568 การโซตัส การใช้อำนาจนิยมและการเลือกปฏิบัติด้วยสิทธิเพศทางความงาม เป็นการกระทำที่ไม่อาจยอมรับได้อย่างไม่มีข้อยกเว้น และอยากส่งเสียงเหล่านี้ไปถึงเพื่อนนักศึกษามหาวิทยาลัยธรรมศาสตร์ พูดเสมอว่าเป็นมหาวิทยาลัยที่มีเสรีภาพทุกตารางนิ้ว ยึดถือประชาธิปไตย ความเท่าเทียม ตนเห็นว่าการโซตัสเป็นสิ่งที่ไม่ควรมีที่สุดในมหาวิทยาลัยที่พร่ำพูดเรื่องนี้มาโดยตลอด อย่างไรก็ตาม การใช้อำนาจนิยมยังคงมีให้เห็นอยู่ในหลายองค์กร ตนอยากให้เรื่องนี้เป็นมาตรฐานขั้นต่ำที่เพื่อน ๆ ในมหาวิทยาลัยธรรมศาสตร์ทุกคนร่วมกันยึดถือ และอยากให้ทุกคนแสดงจุดยืนว่าสิ่งนี้เป็นสิ่งที่ไม่อาจยอมรับได้ในปีพุทธศักราช 2568 และขอเสนอสัดส่วนคณะกรรมาธิการวิสามัญ ดังกล่าว โดยมีองค์การนักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ 5 คน และสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ 8 คน โดยแบ่งเป็นพรรครีนิว ทีพีซี 5 คน และ พรรครีไลฟ์ ท่าพระจันทร์ 3 คน รวมสมาชิกทั้งหมด 13 คน"}]]]}]
8a:["$","p","68",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณรัชพล สังวรธรรม ประธานในที่ประชุม กล่าวว่า มีผู้ใดต้องการอภิปรายเพิ่มเติมหรือไม่ หากไม่มีลำดับต่อไปจะเป็นการโหวตรับรองญัตติดังกล่าว"}]]]}]
8b:["$","p","69",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณกัสกร เขจรลาภ อุปนายกองค์การนักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ กล่าวว่า ขอให้ท่านประธานอภิปรายเพิ่มเติมว่าเรื่องที่สามารถตักเตือนหรือให้หยุดทำกิจกรรมนั้น พูดถึงกิจกรรมภายใต้คณะกรรมการนักศึกษาประจำคณะ หรือพูดถึงผู้ดำเนินกิจกรรม"}]]]}]
8c:["$","p","70",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณศุภชัย นาคเจือทอง สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีนิว ทีพีซี กล่าวตอบว่า หากอ้างอิงตามข้อ 13 เมื่อมีมติแล้วว่าการดำเนินกิจกรรมนักศึกษาเป็นการฝ่าฝืนความในข้อ 6 ก็ให้คณะกรรมการบริหารองค์การนักศึกษาหรือคณะกรรมการบริหารองค์การระดับศูนย์ ออกคำสั่งตักเตือนผู้ดำเนินกิจกรรมนักศึกษานั้น ๆ เป็นผู้ที่ดำเนินกิจกรรมนักศึกษาที่ละเมิดความในข้อ 6 และ 7"}]]]}]
