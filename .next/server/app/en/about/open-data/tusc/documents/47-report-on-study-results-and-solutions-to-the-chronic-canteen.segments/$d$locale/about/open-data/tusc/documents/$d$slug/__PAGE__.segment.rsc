a6:["$","p","126",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"นกพิราบก่อให้เกิดผลกระทบต่อผู้ใช้บริการในหลายด้าน ทั้งการบินรบกวนและแย่งอาหารบนโต๊ะโดยตรง การถ่ายมูลปนเปื้อนบนโต๊ะ เก้าอี้ และภาชนะ ซึ่งเป็นความเสี่ยงด้านสุขอนามัยอย่างมีนัยสำคัญ เนื่องจากนกพิราบเป็นพาหะนำโรคหลายชนิด นอกจากนี้ยังสร้างบรรยากาศที่ไม่น่าใช้บริการและลดคุณภาพชีวิตของนักศึกษาและบุคลากรโดยรวม"}]]]}]
a7:["$","blockquote","127",{"className":"m-0 flex flex-col gap-[var(--space-3)] border-l-4 border-line-strong pl-[var(--space-4)] text-ink-900","children":[["$","p","0",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"[ภาพ: ภาพถ่ายสองภาพ นกพิราบบนโต๊ะและม้านั่งในโรงอาหาร ภาพซ้ายมีนกกินอาหารบนโต๊ะและอีกตัวยืนบนม้านั่ง ภาพขวามีนกสี่ตัวบนโต๊ะ ไม่มีคำบรรยาย]"}]]]}]]}]
a8:["$","h5","128",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"2.5 ปัญหาด้านราคาและคุณภาพอาหาร"}]]]}]
a9:["$","p","129",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"จากการลงพื้นที่สำรวจและรับฟังความคิดเห็นจากผู้ประกอบการและผู้ใช้บริการ คณะกรรมาธิการฯ พบว่าปัญหาราคาอาหารที่ไม่สอดคล้องกับปริมาณและคุณภาพที่ได้รับนั้น มีสาเหตุหลักมาจากโครงสร้างต้นทุนของผู้ประกอบการที่อยู่ในระดับสูง โดยเฉพาะค่าเช่าพื้นที่ภายในโรงอาหารซึ่งเป็นภาระค่าใช้จ่ายคงที่ที่ผู้ประกอบการต้องรับผิดชอบในแต่ละรอบสัญญา อย่างไรก็ดี ยอดขายที่เกิดขึ้นจริงกลับไม่เป็นไปตามที่คาดการณ์ไว้ เนื่องจากจำนวนที่นั่งที่ไม่เพียงพอและปัญหาด้านสภาพแวดล้อมโดยรวมของโรงอาหารส่งผลให้ผู้ใช้บริการบางส่วนหลีกเลี่ยงการเข้ามารับประทานอาหารภายในพื้นที่ เมื่อรายได้ไม่เป็นไปตามเป้าหมายในขณะที่ต้นทุนคงที่"}]]]}]
aa:["$","p","130",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 19 of the original]"}]
ab:["$","p","131",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ยังคงอยู่ในระดับสูง ผู้ประกอบการจึงจำเป็นต้องปรับราคาจำหน่ายอาหารให้สูงขึ้นเพื่อรักษาสมดุลทางธุรกิจ ซึ่งในที่สุดภาระดังกล่าวก็ตกอยู่กับนักศึกษาและผู้ใช้บริการที่ต้องรับผิดชอบค่าอาหารในราคาที่สูงกว่าความเป็นจริง"}]]]}]
ac:["$","h4","132",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"บทที่ 3 ผลการศึกษาและรวบรวมข้อมูล"}]]]}]
ad:["$","p","133",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"คณะกรรมาธิการวิสามัญได้ดำเนินการศึกษาและรวบรวมข้อมูลสภาพปัญหาที่เกิดขึ้นภายในโรงอาหารมหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ผ่านการลงพื้นที่สำรวจสถานที่จริงและการรวบรวมข้อร้องเรียนจากนักศึกษา บุคลากร และผู้ใช้บริการ โดยสามารถสรุปผลการศึกษาและจัดกลุ่มข้อมูลเชิงประจักษ์ได้ดังนี้"}]]]}]
ae:["$","p","134",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"จากการลงพื้นที่สำรวจสภาพทางกายภาพและสิ่งแวดล้อม คณะกรรมาธิการฯ พบว่าโครงสร้างและครุภัณฑ์หลายส่วนอยู่ในสภาพชำรุดทรุดโทรม โดยเฉพาะระบบระบายอากาศที่มีพัดลมเสียจำนวนมาก ส่งผลให้อากาศภายในพื้นที่รับประทานอาหารไม่ถ่ายเทและเกิดความร้อนสะสม นอกจากนี้ การออกแบบผังพื้นที่ยังไม่เอื้อต่อการจัดการสุขอนามัยที่ดีนัก สังเกตได้จากตำแหน่งของห้องน้ำส่วนกลางที่ตั้งอยู่ติดกับพื้นที่ประกอบอาหาร ซึ่งเสี่ยงต่อการปนเปื้อน ภายในห้องน้ำยังมีสุขภัณฑ์และก๊อกน้ำชำรุด ระยะของอ่างล้างมือที่ไม่สมดุลส่งผลให้เกิดน้ำกระเด็นเปียกชื้นสะสม ตลอดจนพบปัญหาการขาดแคลนวัสดุสิ้นเปลืองขั้นพื้นฐานอย่างสบู่ล้างมือและกระดาษชำระ ในส่วนของพื้นที่ส่วนกลางบริเวณจุดคืนภาชนะ พบว่าการจัดเรียงลำดับจุดทิ้งเศษอาหารและจุดแยกช้อนส้อมยังมีความซับซ้อน ไม่สอดคล้องกับพฤติกรรมการใช้งานและหลักการคัดแยกขยะ ส่งผลให้เกิดความสับสนและมีเศษอาหารหกเลอะเทอะ ยิ่งไปกว่านั้น คณะกรรมาธิการฯ ยังพบร่องรอยและปัญหาการคุกคามจากสัตว์พาหะ โดยเฉพาะนกพิราบที่บินเข้ามาหาเศษอาหารบริเวณโต๊ะรับประทานอาหาร ซึ่งขัดต่อหลักสุขาภิบาลอย่างชัดเจน"}]]]}]
af:["$","p","135",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ควบคู่ไปกับการสำรวจพื้นที่ คณะกรรมาธิการฯ ได้รวบรวมข้อร้องเรียนจากผู้ใช้บริการเพื่อสะท้อนเสียงความเดือดร้อนอย่างรอบด้าน โดยพบว่ามีข้อร้องเรียนเชิงประจักษ์ด้านความสะอาดของอาหารและร้านค้าอย่างต่อเนื่อง เช่น การพบสิ่งเจือปนประเภทเส้นผมและเศษฝอยขัดหม้อในอาหารปรุงสำเร็จ ซึ่งสะท้อนถึงข้อบกพร่องในการควบคุมมาตรฐานสุขาภิบาลส่วนบุคคลของผู้ประกอบการ นอกจากนี้ ยังมีประเด็นมลพิษทางอากาศจากจุดสูบบุหรี่ (Smoking Zone) ที่มีการจัดการไม่รัดกุมและตั้งอยู่ใกล้ลับบริเวณโรงอาหารมากเกินไป ทำให้กลิ่นและควันพัดเข้ามาสร้างความรำคาญและกระทบต่อสุขภาพทางเดินหายใจของผู้ใช้บริการ ตลอดจนมีการร้องเรียนถึงความ"}]]]}]
