cd:["$","p","165",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในระยะยาว การปรับโครงสร้างราคาอาหารให้เป็นธรรมและเข้าถึงได้มากขึ้นโดยอาศัยการเพิ่มขึ้นของ \"ยอดขาย\" และ \"ยอดซื้อ\" นั้น สามารถอธิบายและพิสูจน์ได้อย่างเป็นรูปธรรมผ่านหลักการทางเศรษฐศาสตร์เรื่อง การประหยัดต่อขนาด (Economies of Scale) โดยมีหัวใจสำคัญอยู่ที่ความเข้าใจเรื่องพฤติกรรมของต้นทุน"}]]]}]
ce:["$","p","166",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในธุรกิจร้านอาหาร ต้นทุนทั้งหมดในการผลิตอาหารหนึ่งจาน หรือต้นทุนเฉลี่ย (AC) จะประกอบไปด้วยสองส่วนหลัก ส่วนแรกคือ \"ต้นทุนคงที่\" (FC) เช่น ค่าเช่าพื้นที่หรือค่าจ้างพนักงานประจำ ซึ่งเป็นรายจ่ายที่ร้านค้าต้องแบกรับเท่าเดิมเสมอไม่ว่าจะขายได้กี่จานก็ตาม ส่วนที่สองคือ \"ต้นทุนผันแปร\" (V) ซึ่งก็คือค่าวัตถุดิบต่างๆ ที่แปรผันตามจำนวนจานที่ขายได้ เมื่อนำมาเขียนเป็นสมการเพื่อหาต้นทุนเฉลี่ยต่อจาน จะได้ว่า"}]]]}]
