9b:["$","blockquote","115",{"className":"m-0 flex flex-col gap-[var(--space-3)] border-l-4 border-line-strong pl-[var(--space-4)] text-ink-900","children":[["$","p","0",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"[ภาพ: ภาพถ่ายสองภาพ ภาพซ้ายเป็นที่ใส่กระดาษชำระแบบม้วนใหญ่สีดำติดผนังหินในห้องน้ำ มีมือถือโทรศัพท์และมือชี้ ภาพขวาเป็นถาดพลาสติกสีเทามีช่องใส่ช้อนส้อมสี่ช่อง ไม่มีคำบรรยาย]"}]]]}]]}]
