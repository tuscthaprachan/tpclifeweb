e9:["$","p","186",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Should there be multiple vice chairmen, the first vice chairman shall assume the duties of the chairman. If the first vice chairman is unable to perform said duties, the vice chairman in the successive order shall assume the duties of the chairman."}]]]}]
