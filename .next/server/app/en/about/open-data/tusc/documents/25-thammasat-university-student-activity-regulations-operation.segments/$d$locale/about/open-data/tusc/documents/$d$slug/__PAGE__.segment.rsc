17c:["$","p","333",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"and receives votes exceeding half of the quorum, except for rulings which are deemed final according to the regulations."}]]]}]
17d:["$","p","334",{"id":"clause-119","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 119"}]]}],["$","$3","1",{"children":" These regulations shall be prepared in Thai and English, with the Thai version being the primary enforceable version. In the event of conflicts, discrepancies, or interpretation issues between the Thai version and the translated English version, the text according to the Thai version regulations shall prevail as the standard."}]]]}]
17e:["$","h4","335",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Transitory Provisions"}]]]}]
17f:["$","p","336",{"id":"clause-120","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 120"}]]}],["$","$3","1",{"children":" These regulations shall not affect any documents, notifications, or affairs of the Council that were completed prior to the promulgation of these regulations. For any pending matters, proceedings shall be carried out in accordance with these regulations."}]]]}]
180:["$","p","337",{"id":"clause-121","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 121"}]]}],["$","$3","1",{"children":" Any documents, notifications, or affairs that conflict with these regulations shall be subject to these rules"}]]]}]
