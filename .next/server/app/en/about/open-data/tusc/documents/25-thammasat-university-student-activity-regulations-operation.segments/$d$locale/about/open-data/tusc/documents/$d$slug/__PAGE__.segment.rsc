eb:["$","p","188",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"In the event that no individual is capable of performing the duties pursuant to paragraphs two and three, any commissioner may nominate another commissioner to assume the duties of the chairman, subject to an affirmative resolution by the committee assembly with a vote exceeding one-half of the existing number of commissioners."}]]]}]
