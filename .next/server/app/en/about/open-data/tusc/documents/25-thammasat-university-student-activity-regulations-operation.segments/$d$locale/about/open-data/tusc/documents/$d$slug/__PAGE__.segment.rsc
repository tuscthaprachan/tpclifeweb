ee:["$","p","191",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Sub-commissioners are ineligible to hold positions pursuant to Clause 64, paragraph two."}]]]}]
ef:["$","p","192",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Sub-commissioners maintain the right to attend Council meetings but are not entitled to vote on any matters of the Council. Furthermore, if the chairman of the committee or the Chairman deems it appropriate, sub-commissioners may be denied attendance at the meeting."}]]]}]
