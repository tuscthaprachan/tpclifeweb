109:["$","p","218",{"id":"clause-73","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 73"}]]}],["$","$3","1",{"children":" In the event a commissioner position within any committee becomes vacant, the chairman of the committee shall hold the authority to appoint a member as a replacement commissioner. The chairman must formally notify the President of the Council of such appointment within seven days from the date thereof."}]]]}]
