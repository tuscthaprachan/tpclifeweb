129:["$","p","250",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"However, if there are a large number of general interpellations waiting to be placed on the meeting agenda or general interpellations postponed from the previous meeting, the President of the Council may place more general interpellations than this."}]]]}]
12a:["$","p","251",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"The arrangement of interpellations in the assembly shall be ordered as follows: urgent verbal interpellations, and general interpellations."}]]]}]
12b:["$","p","252",{"id":"clause-85","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 85"}]]}],["$","$3","1",{"children":" The President of the Student Union, Vice President of the Student Union, Council's Executive Board, member, or outsider, depending on the case, who is being questioned must attend the Council meeting to answer the interpellation on that matter in person, unless there is an unavoidable necessity preventing them from answering, but they must notify the President of the Council of such necessity in writing before or on the day of the Council meeting, and specify when they will be able to answer."}]]]}]
12c:["$","p","253",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"In the event of assigning another relevant person to answer the interpellation, written notification must be given to the President of the Council prior to the interpellation agenda. The President of the Student Union, Vice President of the Student Union, Council's Executive Board, member, or outsider naturally has the right not to answer an interpellation when the questioner considers that the matter should not yet be disclosed because it involves the safety or significant interests of the University."}]]]}]
12d:["$","p","254",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 26 of the original]"}]
12e:["$","p","255",{"id":"clause-86","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 86"}]]}],["$","$3","1",{"children":" Raising an interpellation must be clear, not excessive, circular, repetitive, or having the nature of a debate."}]]]}]
12f:["$","p","256",{"id":"clause-87","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 87"}]]}],["$","$3","1",{"children":" The questioner has the right to withdraw the interpellation at any time."}]]]}]
130:["$","p","257",{"id":"clause-88","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 88"}]]}],["$","$3","1",{"children":" For any interpellation where the President of the Council considers that circumstances have changed, the President of the Council may order its removal from waiting to be placed on the meeting agenda, upon receiving the consent of the questioner."}]]]}]
131:["$","p","258",{"id":"clause-89","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 89"}]]}],["$","$3","1",{"children":" An interpellation lapses when:"}]]]}]
132:["$","ul","259",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[1,". ",[["$","$3","0",{"children":"Reaching the interpellation agenda of any person, if the questioner does not ask or is not in the assembly."}]]],[]]}]]}]
133:["$","ul","260",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[2,". ",[["$","$3","0",{"children":"The membership of the questioner terminates."}]]],[]]}]]}]
134:["$","ul","261",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[3,". ",[["$","$3","0",{"children":"The questioned person vacates office."}]]],[]]}]]}]
135:["$","ul","262",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[4,". ",[["$","$3","0",{"children":"The Council expires."}]]],[]]}]]}]
136:["$","h5","263",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Part 2: Urgent Verbal Interpellations"}]]]}]
137:["$","p","264",{"id":"clause-90","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 90"}]]}],["$","$3","1",{"children":" For raising an urgent verbal interpellation, each member has the right to raise one interpellation per time on a meeting day, without prior notice, and it must have any of the following characteristics:"}]]]}]
138:["$","ul","265",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[1,". ",[["$","$3","0",{"children":"An important matter of interest to students."}]]],[]]}]]}]
139:["$","ul","266",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[2,". ",[["$","$3","0",{"children":"A matter affecting the interests of the University and students."}]]],[]]}]]}]
13a:["$","p","267",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 27 of the original]"}]
13b:["$","ul","268",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[3,". ",[["$","$3","0",{"children":"An urgent matter. It is the power of the President of the Council to rule whether any interpellation is an urgent verbal interpellation."}]]],[]]}]]}]
13c:["$","p","269",{"id":"clause-91","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 91"}]]}],["$","$3","1",{"children":" In any meeting where there are more than three urgent verbal interpellations ruled by the President of the Council, the President of the Council shall draw lots to leave only three. Among these three, if it appears that there are interpellations of a similar nature, the interpellation drawn later shall lapse."}]]]}]
13d:["$","p","270",{"id":"clause-92","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 92"}]]}],["$","$3","1",{"children":" Urgent verbal interpellations ruled by the President of the Council under Clause 90 or processed under Clause 91 shall be placed on the urgent verbal interpellation agenda."}]]]}]
13e:["$","p","271",{"id":"clause-93","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 93"}]]}],["$","$3","1",{"children":" Asking and answering urgent verbal interpellations in a single meeting has a time limit not exceeding ninety minutes."}]]]}]
13f:["$","p","272",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Any matter the President of the Council rules does not meet the characteristics of an urgent verbal interpellation under Clause 90, or is not permitted to be placed on the meeting agenda, or is not asked and answered for any other reason than a request for postponement by the questioned party, shall lapse."}]]]}]
140:["$","p","273",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"If the member still wishes to raise it as an urgent verbal interpellation, it shall be proposed anew for consideration next time."}]]]}]
141:["$","p","274",{"id":"clause-94","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 94"}]]}],["$","$3","1",{"children":" Each urgent verbal interpellation may be asked no more than three times per matter and must be completely asked and answered within a thirty-minute time limit, unless in any meeting there are fewer than three urgent verbal interpellations, in which case the time may be extended proportionally within a sixty-minute limit."}]]]}]
142:["$","p","275",{"id":"clause-95","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 95"}]]}],["$","$3","1",{"children":" During the asking of an urgent verbal interpellation, if the President rules that any question falls under the prohibited characteristics under Clause 80, the President has the power to order the question to be changed."}]]]}]
143:["$","p","276",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 28 of the original]"}]
144:["$","h5","277",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Part 3: General Interpellations"}]]]}]
145:["$","p","278",{"id":"clause-96","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 96"}]]}],["$","$3","1",{"children":" Raising a general interpellation must be submitted in advance in writing to the President of the Council, containing questions on facts or policies, and specifying that it be answered in the Council meeting."}]]]}]
146:["$","p","279",{"id":"clause-97","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 97"}]]}],["$","$3","1",{"children":" The President of the Council shall rule whether any interpellation has prohibited characteristics under Clause 80 or characteristics under Clause 81, and upon ruling, notify the questioner within seven days."}]]]}]
147:["$","p","280",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Interpellations ruled by the President of the Council to be proper interpellations shall be sent to the questioned party."}]]]}]
148:["$","p","281",{"id":"clause-98","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 98"}]]}],["$","$3","1",{"children":" Interpellations requiring an answer in the Council meeting shall be placed on the meeting agenda within fifteen days from the date of sending to the Prime Minister or Minister under Clause 97 paragraph two."}]]]}]
149:["$","p","282",{"id":"clause-99","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 99"}]]}],["$","$3","1",{"children":" Raising a general interpellation under Clause 96 shall be placed as the first member's interpellation on the meeting agenda according to the order of submission to the President of the Council."}]]]}]
14a:["$","h4","283",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Chapter 5 General Debates"}]]]}]
14b:["$","h5","284",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Part 1: General Debate for a Vote of No Confidence"}]]]}]
14c:["$","p","285",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 29 of the original]"}]
14d:["$","p","286",{"id":"clause-100","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 100"}]]}],["$","$3","1",{"children":" When a member wishes to propose a motion requesting a general debate, a written document must be submitted to the President of the Council indicating a general debate for a vote of no confidence against the Executive Board, either individually or as a whole, and specifying the matters."}]]]}]
14e:["$","p","287",{"id":"clause-101","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 101"}]]}],["$","$3","1",{"children":" When the President of the Council receives the motion under Clause 100, a review shall be conducted, and if there are defects, the President of the Council shall inform the proposer within seven days from the date of receiving the motion."}]]]}]
14f:["$","p","288",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Once the President of the Council has verified the correctness of the motion, it shall be placed on the meeting agenda as an urgent matter and the Council's Executive Board shall be informed."}]]]}]
150:["$","p","289",{"id":"clause-102","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 102"}]]}],["$","$3","1",{"children":" Only the Council's Executive Board has the right to debate and clarify. The clarification under paragraph one may clarify the members' debates one by one in order, or may wait to clarify multiple persons at once."}]]]}]
151:["$","p","290",{"id":"clause-103","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 103"}]]}],["$","$3","1",{"children":" For the debate, the provisions in Chapter 2, Part 3 Debate, shall apply mutatis mutandis."}]]]}]
152:["$","h5","291",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Part 2: General Debate without a Resolution"}]]]}]
153:["$","p","292",{"id":"clause-104","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 104"}]]}],["$","$3","1",{"children":" A motion requesting a general debate without a resolution must be made in writing and submitted to the President of the Council, clearly specifying to which person and regarding what matter the factual questions or problem suggestions are directed."}]]]}]
154:["$","p","293",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"When the President of the Council receives the motion under paragraph one, the provisions in Clause 101 shall apply mutatis mutandis."}]]]}]
155:["$","p","294",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 30 of the original]"}]
156:["$","p","295",{"id":"clause-105","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 105"}]]}],["$","$3","1",{"children":" For the debate, the provisions in Chapter 2, Part 3 Debate, shall apply mutatis mutandis."}]]]}]
157:["$","h4","296",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Chapter 6 Maintenance of Order and Propriety"}]]]}]
158:["$","p","297",{"id":"clause-106","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 106"}]]}],["$","$3","1",{"children":" Any acts that disrupt the Council meeting are prohibited."}]]]}]
159:["$","p","298",{"id":"clause-107","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 107"}]]}],["$","$3","1",{"children":" If anyone violates these regulations, the President has the power to warn, prohibit, order the withdrawal of words, prohibit speaking on the matter currently under consultation, demand an apology in the assembly, or order removal from the meeting with or without a specified time frame on that occasion."}]]]}]
15a:["$","p","299",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"In the event that the President orders anyone to leave the meeting, if that person resists, the President has the power to order security personnel or University staff to remove the person from the meeting venue or out of the Council Precinct."}]]]}]
15b:["$","p","300",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"In meetings via electronic media, if that person resists, the President has the power to expel them from the meeting according to methods prescribed by the President."}]]]}]
15c:["$","p","301",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"The President's order under this clause is deemed final."}]]]}]
15d:["$","p","302",{"id":"clause-108","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 108"}]]}],["$","$3","1",{"children":" Calling and identifying the names of persons shall be done as follows:"}]]]}]
15e:["$","ul","303",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[1,". ",[["$","$3","0",{"children":"In calling or identifying one's own name, it is the freedom of that person to use or not use a name prefix."}]]],[]]}]]}]
15f:["$","ul","304",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[2,". ",[["$","$3","0",{"children":"In calling or identifying the name of another person, the name prefix of that person must not be called or identified, unless that person wishes for the name prefix to be used."}]]],[]]}]]}]
160:["$","p","305",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 31 of the original]"}]
161:["$","p","306",{"id":"clause-109","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 109"}]]}],["$","$3","1",{"children":" Attire for entering the Council meeting or Council Precinct is the freedom of the individual to wear any style, provided they are not naked."}]]]}]
162:["$","p","307",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Displaying media or images containing profanity or rude words in meetings via electronic media is permitted, provided it does not specifically attack any individual and does not display obscene images."}]]]}]
163:["$","p","308",{"id":"clause-110","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 110"}]]}],["$","$3","1",{"children":" Members have the right to attend Council meetings and committee meetings, and no person can obstruct them, except in violation of these regulations under Clause 78."}]]]}]
164:["$","h4","309",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Chapter 7 Termination of the Council's Executive Board"}]]]}]
165:["$","p","310",{"id":"clause-111","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 111"}]]}],["$","$3","1",{"children":" The Council's Executive Board vacates office upon:"}]]]}]
166:["$","ul","311",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[1,". ",[["$","$3","0",{"children":"Expiration of the Council's term."}]]],[]]}]]}]
167:["$","ul","312",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[2,". ",[["$","$3","0",{"children":"Death."}]]],[]]}]]}]
168:["$","ul","313",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[3,". ",[["$","$3","0",{"children":"Resignation."}]]],[]]}]]}]
169:["$","ul","314",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[4,". ",[["$","$3","0",{"children":"Termination of membership."}]]],[]]}]]}]
16a:["$","ul","315",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[5,". ",[["$","$3","0",{"children":"A resolution of the Council to vacate office according to the motion in Clause 30, with an approval vote of no less than two-thirds of the total existing members of the Council."}]]],[]]}]]}]
16b:["$","p","316",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 32 of the original]"}]
16c:["$","h4","317",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Chapter 8 Council Orders"}]]]}]
16d:["$","p","318",{"id":"clause-112","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 112"}]]}],["$","$3","1",{"children":" A Council Order refers to an official directive approved by the Council Executive Committee issued to a member of the Executive Committee or, where applicable, to a member of the Council. Such orders may mandate the performance of duties, the suspension of duties, or the execution of any acts pertaining to the interests of the students, the University, or the Council."}]]]}]
16e:["$","p","319",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"Any order requiring an Executive Committee member to temporarily cease the performance of their duties shall require the additional approval of the Joint Coordination Committee."}]]]}]
16f:["$","p","320",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"The President of the Council shall declare the necessity of such Council Order to the members within one day from the date on which the President signs the official Council Order document."}]]]}]
170:["$","p","321",{"id":"clause-113","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 113"}]]}],["$","$3","1",{"children":" Council orders must be published to the public via the Council's electronic media within three days from the date the President signs the Council order, unless members request it to remain secret, which requires an approval resolution of no less than one-third of the total existing members."}]]]}]
171:["$","p","322",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"If members object and request public publication, a resolution of approval from more than one-fourth of the total existing members is required before it can be published."}]]]}]
172:["$","p","323",{"className":"m-0 border-t border-line pt-[var(--space-2)] text-sm text-ink-600","children":"[Page 33 of the original]"}]
173:["$","h4","324",{"className":"m-0 mt-[var(--space-4)]","children":[[],[["$","$3","0",{"children":"Chapter 9 Final Provisions"}]]]}]
174:["$","p","325",{"id":"clause-114","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 114"}]]}],["$","$3","1",{"children":" If the President requests consultation or a member proposes a motion, seconded by no less than ten members, to temporarily suspend the application of any clause of these regulations in whole or in part for a specific case, and if the assembly approves with votes of no less than two-thirds of the quorum, the application may be suspended."}]]]}]
175:["$","p","326",{"id":"clause-115","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 115"}]]}],["$","$3","1",{"children":" If the President of the Council rules that any operation is an extremely urgent matter, and the Council's Executive Board and the Joint Council Coordinating Committee resolve approval with no less than two-thirds of the existing members of each committee, by notifying members of the reasons and such operations, it shall be mutatis mutandis deemed a Council resolution."}]]]}]
176:["$","p","327",{"id":"clause-116","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 116"}]]}],["$","$3","1",{"children":" If there are issues requiring interpretation of these regulations, it shall be the power of the Council to rule, and once the assembly has made a ruling resolution with votes of no less than half of the existing members of the Council, that ruling shall be deemed final."}]]]}]
177:["$","p","328",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"A request for the assembly to rule under paragraph one may be done by the President requesting consultation or a member proposing a motion seconded by no less than ten members."}]]]}]
178:["$","p","329",{"id":"clause-117","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 117"}]]}],["$","$3","1",{"children":" A request to amend these regulations must be proposed as a motion seconded by no less than ten members."}]]]}]
179:["$","p","330",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"A resolution to amend these regulations requires approval with votes of no less than two-thirds of the total existing members of the Council."}]]]}]
17a:["$","p","331",{"id":"clause-118","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"Clause 118"}]]}],["$","$3","1",{"children":" An objection to the ruling or discretion of the President can be made in the event that a member proposes a motion to object, seconded by no less than ten members,"}]]]}]
