e6:["$","p","183",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"The chairman of each committee shall appoint a vice chairman, a secretary, and other positions as necessitated, from among the commissioners within that committee."}]]]}]
e7:["$","p","184",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"In the event that commissioners are appointed to hold the position of vice chairman in a number exceeding one, or to other positions pursuant to paragraph two, the chairman of the committee must notify the President of the Council and the committee assembly regarding the necessity thereof."}]]]}]
