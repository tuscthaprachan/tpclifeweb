6b:["$","p","68",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ให้โอนรายได้และทรัพย์สินของกองทุนแลกเปลี่ยนนักศึกษาประจำคณะมาเป็นรายได้และทรัพย์สินของกองทุน (ชื่อคณะ) ตามข้อบังคับนี้"}]]]}]
6c:["$","p","69",{"id":"clause-19","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ ๑๙"}]]}],["$","$3","1",{"children":" การดำเนินการตามกองทุนเพื่อการแลกเปลี่ยนนักศึกษา (วิเทศสัมพันธ์) ที่มีอยู่ก่อนวันที่ข้อบังคับนี้มีผลใช้บังคับ ให้ดำเนินการตามหลักเกณฑ์และวิธีการที่กำหนดไว้ในข้อบังคับมหาวิทยาลัยว่าด้วยการจัดตั้งและการบริหารกองทุนเพื่อการแลกเปลี่ยนนักศึกษาต่อไปจนกว่าการดำเนินการจะแล้วเสร็จหรือสิ้นสุดลง"}]]]}]
