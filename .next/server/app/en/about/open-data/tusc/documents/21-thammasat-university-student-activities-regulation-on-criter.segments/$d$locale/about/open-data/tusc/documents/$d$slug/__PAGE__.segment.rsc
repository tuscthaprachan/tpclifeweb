48:["$","p","24",{"id":"clause-6","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 6"}]]}],["$","$3","1",{"children":" การยื่นคำของบประมาณสำหรับดำเนินโครงการ จะต้องคำนึงถึงวัตถุประสงค์ของโครงการ ความคุ้มค่าในการใช้จ่ายงบประมาณ และผลประโยชน์ของนักศึกษาเป็นสำคัญ"}]]]}]
49:["$","p","25",{"id":"clause-7","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 7"}]]}],["$","$3","1",{"children":" คณะกรรมการบริหารองค์การนักศึกษามีอำนาจในการกำหนดรูปแบบเอกสาร และระยะเวลาในการรับการเสนอโครงการและคำของบประมาณ โดยต้องหารือร่วมกับคณะกรรมการบริหารองค์การนักศึกษาระดับศูนย์"}]]]}]
4a:["$","p","26",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"การกำหนดระยะเวลาตามวรรคแรก ต้องแจ้งต่อองค์กรซึ่งมีสิทธิเสนอโครงการและคำของบประมาณล่วงหน้าไม่น้อยกว่า 7 วัน นับแต่วันแรกที่มีการเปิดให้ส่งเอกสาร"}]]]}]
4b:["$","p","27",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"หากองค์กรใดไม่เสนอโครงการและคำของบประมาณภายในระยะเวลาตามที่คณะกรรมการบริหารองค์การนักศึกษากำหนด ให้ถือว่าองค์กรนั้นสละสิทธิในการรับการจัดทำงบประมาณ และการพิจารณางบประมาณในรอบดังกล่าว"}]]]}]
4c:["$","p","28",{"id":"clause-8","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 8"}]]}],["$","$3","1",{"children":" ให้องค์กรผู้เสนอโครงการและขอยื่นคำขอประมาณ เข้าชี้แจงรายละเอียดของโครงการ โดยส่งตัวแทนองค์กรละไม่เกิน 2 คน เข้าชี้แจงโดยละเอียดตามที่คณะกรรมการบริหารองค์การนักศึกษา หรือคณะกรรมการบริหารองค์การนักศึกษาระดับศูนย์นัดหมาย"}]]]}]
4d:["$","p","29",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"กรณีองค์กรใดไม่ดำเนินการตามวรรคแรกให้ถือว่าองค์กรนั้นยอมรับผลการพิจารณาของคณะกรรมการบริหารองค์การนักศึกษาการนักศึกษา หรือคณะกรรมการบริหารองค์การนักศึกษาระดับศูนย์โดยปริยาย"}]]]}]
4e:["$","p","30",{"id":"clause-9","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 9"}]]}],["$","$3","1",{"children":" ภายหลังจากที่คณะกรรมการบริหารองค์การนักศึกษาได้ดำเนินการตามข้อ 7 แล้วเสร็จ ให้คณะกรรมการบริหารองค์การนักศึกษาจัดทำแผนงบประมาณกิจกรรมนักศึกษาเพื่อเสนอต่อสภานักศึกษาพิจารณาต่อไป"}]]]}]
