51:["$","p","33",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"การกำหนดระยะเวลาตามวรรคแรก ต้องแจ้งต่อคณะกรรมการบริหารองค์การนักศึกษาล่วงหน้าไม่น้อยกว่า 30 วัน นับแต่วันที่จะมีการพิจารณางบประมาณโดยสภานักศึกษาวาระที่หนึ่ง"}]]]}]
