63:["$","h5","35",{"id":"item-6-1","className":"m-0 mt-[var(--space-6)] border-t border-line pt-[var(--space-3)]","style":"$undefined","children":[[],[["$","$1","0",{"children":"6.1 ญัตติด่วน เรื่อง พิจารณาถอดถอนประธานคณะกรรมาธิการการเมือง และส่งเสริมประชาธิปไตย ท่าพระจันทร์ ออกจากตำแหน่ง"}]]]}]
64:["$","div","36",{"id":"$undefined","className":"flex max-w-[var(--measure-th)] flex-col gap-[var(--space-1)] border-t border-line pt-[var(--space-3)]","children":[[],["$","p",null,{"className":"m-0","children":["$","strong",null,{"children":"คุณโทมัส สตีเว่น เรย์โนลด์ส สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีนิว ทีพีซี"}]}],["$","p",null,{"className":"m-0 whitespace-pre-line","children":[["$","$1","0",{"children":" กล่าวว่า ด้วยปรากฏข้อเท็จจริงว่า นายกานต์พิทักษ์ มติมหาราษฎร์ ประธานคณะกรรมาธิการการเมือง และส่งเสริมประชาธิปไตย ท่าพระจันทร์ ซึ่งเป็นหนึ่งในคณะกรรมการบริหารสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ได้แสดงพฤติกรรมไม่เหมาะสม โดยมีการส่งข้อความผ่านสื่ออิเล็กทรอนิกส์ในลักษณะข่มขู่ และมีเนื้อหาสื่อไปในทางล่วงละเมิดทางเพศ อันเป็นการกระทำที่ไม่เหมาะสมในฐานะผู้ดำรงตำแหน่งในองค์กรนักศึกษา และส่งผลกระทบต่อภาพลักษณ์และความเชื่อมั่นต่อสภานักศึกษาฯ ท่าพระจันทร์ ของประชาคมธรรมศาสตร์ เพื่อแสดงให้เห็นว่าสภานักศึกษาฯ ท่าพระจันทร์ มีจุดยืนในการไม่ยอมรับการคุกคามทางเพศทุกรูปแบบ และดำรงไว้ซึ่งหลักสิทธิ ความโปร่งใส และเคารพต่อสิทธิศักดิ์ศรีความเป็นมนุษย์ ข้าพเจ้าและคณะจึงขอเสนอญัตติโดยอาศัยอำนาจตามความในข้อ 30 แห่งระเบียบกิจกรรมนักศึกษามหาวิทยาลัยธรรมศาสตร์ ว่าด้วยการดำเนินงานและการประชุมสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พ.ศ. 2565 ให้มีการพิจารณาดำเนินการถอดถอดบุคคลดังกล่าว"}]]}]]}]
