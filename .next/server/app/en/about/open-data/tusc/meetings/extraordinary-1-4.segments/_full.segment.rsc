k-900","children":[["$","$1","0",{"children":"คณะศิลปศาสตร์"}]]}]]}],["$","tr","1",{"children":[["$","td","c0",{"className":"px-[var(--space-2)] py-[var(--space-2)] align-top sm:px-[var(--space-3)] border-t border-line text-ink-900","children":[["$","$1","0",{"children":"2"}]]}],["$","td","c1",{"className":"px-[var(--space-2)] py-[var(--space-2)] align-top sm:px-[var(--space-3)] border-t border-line text-ink-900","children":[["$","$1","0",{"children":"กัญญารัตน์"}]]}],["$","td","c2",{"className":"px-[var(--space-2)] py-[var(--space-2)] align-top sm:px-[var(--space-3)] border-t border-line text-ink-900","children":[["$","$1","0",{"children":"รักษ์แพทย์"}]]}],["$","td","c3",{"className":"px-[var(--space-2)] py-[var(--space-2)] align-top sm:px-[var(--space-3)] border-t border-line text-ink-900","children":[["$","$1","0",{"children":"วิทยาลัยสหวิทยาการ"}]]}]]}]]}],null]}]}]
