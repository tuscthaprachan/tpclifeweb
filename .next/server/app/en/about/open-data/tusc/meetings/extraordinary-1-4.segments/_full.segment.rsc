82:["$","div","58",{"id":"$undefined","className":"flex max-w-[var(--measure-th)] flex-col gap-[var(--space-1)] border-t border-line pt-[var(--space-3)]","children":[[],["$","p",null,{"className":"m-0","children":["$","strong",null,{"children":"คุณอนุชิต ไตรทิพย์ สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีไลฟ์ ท่าพระจันทร์"}]}],["$","p",null,{"className":"m-0 whitespace-pre-line","children":[["$","$1","0",{"children":" กล่าวว่า ตนเชื่อว่ากรรมาธิการจะมีประสิทธิภาพในการดำเนินงานในส่วนพิทักษ์สิทธิ์นักศึกษาดียิ่งขึ้น และเชื่อว่ากระบวนการในการแก้ปัญหาโซตัสที่จะได้ผลมากที่สุดนอกเหนือจากกฎระเบียบต้องมีกระบวนการในการตรวจสอบและพิจารณา ให้กระบวนการเหล่านี้มีประสิทธิผลมากขึ้น จากการดำเนินงานและจากการแก้ปัญหาเรื่องโซตัส ไม่ว่าจะเป็นเรื่องโซตัสในคณะก็ดี หรือหน่วยงานที่ใหญ่ขึ้นเองก็ดี และตนเชื่อว่าทุกวันนี้ยังคงมีการโซตัสอยู่ ตนมีความคิดเห็นว่าสภานักศึกษา ท่าพระจันทร์ จะมีฉันทามติคิดเห็นตรงกันในการจัดการปัญหาเรื่องโซตัส และการเลือกปฏิบัติด้วยสิทธิเพศทางความงาม ประเด็นนี้เป็นเรื่องสำคัญที่ควรจะจัดการปัญหา และตนเชื่อว่ากรรมาธิการนี้จะเป็นส่วนสำคัญในการผลักดันการแก้ปัญหาเรื่องโซตัสและการเลือกปฏิบัติด้วยสิทธิเพศทางความงามในมหาวิทยาลัยธรรมศาสตร์ ตนเองในฐานะพรรครีไลฟ์ ท่าพระจันทร์ พร้อมสนับสนุนในประเด็นนี้อย่างเข้มแข็ง และเชื่อว่าปัญหานี้จะหายไปด้วยการร่วมมือของทั้งสองพรรคในสภานักศึกษาฯ ท่าพระจันทร์ ไม่ว่าเพื่อน ๆ ในมหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ที่ให้ความร่วมมือก็ดี"}]]}]]}]
