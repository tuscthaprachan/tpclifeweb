7f:["$","p","55",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"สภานักศึกษาและองค์การนักศึกษาที่ต้องปฏิบัติงานร่วมกัน ทำให้สามารถพิจารณาดำเนินการออกประกาศและสั่งยุติไปถึงผู้ที่ดำเนินกิจกรรมนั้น ๆ ได้โดยมิต้องผ่านกระบวนการเข้าสู่สภานักศึกษาระดับศูนย์"}]]]}]
80:["$","div","56",{"id":"$undefined","className":"flex max-w-[var(--measure-th)] flex-col gap-[var(--space-1)] border-t border-line pt-[var(--space-3)]","children":[[],["$","p",null,{"className":"m-0","children":["$","strong",null,{"children":"คุณรัชพล สังวรธรรม ประธานในที่ประชุม"}]}],["$","p",null,{"className":"m-0 whitespace-pre-line","children":[["$","$1","0",{"children":" กล่าวว่า มีท่านใดจะอภิปรายถึงการจัดตั้งคณะกรรมาธิการต่อหรือไม่"}]]}]]}]
81:["$","div","57",{"id":"$undefined","className":"flex max-w-[var(--measure-th)] flex-col gap-[var(--space-1)] border-t border-line pt-[var(--space-3)]","children":[[],["$","p",null,{"className":"m-0","children":["$","strong",null,{"children":"คุณภควัต อินทพรโสภิต สมาชิกสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พรรครีนิว ทีพีซี"}]}],["$","p",null,{"className":"m-0 whitespace-pre-line","children":[["$","$1","0",{"children":" กล่าวว่า ตนมีความประสงค์ที่จะแสดงจุดยืนในการจัดตั้งคณะกรรมาธิการวิสามัญควบคุมและตรวจสอบการดำเนินกิจกรรมอันมีลักษณะเข้าข่ายโซตัส การใช้อำนาจนิยม และการเลือกปฏิบัติทางความงาม ตามที่คุณศุภชัย นาคเจือทอง ได้เสนอญัตติพิจารณาข้างต้น ตนมองว่าการกระทำที่เข้าข่ายการโซตัสนั้นเป็นสิ่งที่ไม่ควรเกิดขึ้น เพราะไม่คำนึงและละเมิดสิทธิมนุษยชน ซึ่งเป็นหลักสากลที่ทุกคนควรจะทราบและเคารพ แต่มีกลุ่มนักศึกษาบางกลุ่มที่เพิกเฉยต่อหลักสากล แม้ตนจะศึกษาในมหาวิทยาลัยที่ยึดถือเรื่องสิทธิและเสรีภาพมากที่สุดในประเทศไทย การกระทำดังกล่าวทำให้ตนและคณะรับไม่ได้เป็นอย่างยิ่ง รวมถึงกรณีสิทธิพิเศษทางความงามที่ยังคงมีอยู่ในสังคมปัจจุบันและเกิดขึ้นในมหาวิทยาลัยธรรมศาสตร์ ตนมีความเชื่อว่าสภานักศึกษาฯ ท่าพระจันทร์ ในที่ประชุมและเพื่อน ๆ นักศึกษาที่ไม่เห็นชอบต่อเหตุการณ์เช่นนี้ และมีความประสงค์ที่จะยกระดับพัฒนามหาวิทยาลัยให้สิ่งเหล่านี้หมดไป ให้มหาวิทยาลัยธรรมศาสตร์มีจุดยืนที่ชัดเจน เพื่อการขับเคลื่อนสังคมให้ก้าวหน้าดั่งที่มักกล่าวเสมอมา ท้ายที่สุดขอเน้นย้ำว่าตนและคณะสนับสนุนการจัดตั้งคณะกรรมาธิการวิสามัญนี้เป็นอย่างยิ่ง"}]]}]]}]
