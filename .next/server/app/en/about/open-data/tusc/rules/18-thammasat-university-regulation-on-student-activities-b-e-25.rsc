182:["$","p","329",{"id":"clause-92","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$1","0",{"children":"ข้อ ๙๒"}]]}],["$","$1","1",{"children":" ให้องค์การนักศึกษาที่มีอยู่ก่อนวันที่ข้อบังคับนี้มีผลใช้บังคับ ปฏิบัติหน้าที่เป็นองค์การนักศึกษา องค์การนักศึกษา ศูนย์ท่าพระจันทร์ องค์การนักศึกษา ศูนย์รังสิต หรือองค์การนักศึกษา ศูนย์ลำปางตามข้อบังคับนี้ แล้วแต่กรณี"}]]]}]
183:["$","p","330",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"และให้นายกองค์การนักศึกษา อุปนายกองค์การนักศึกษา กรรมการบริหารองค์การนักศึกษา และตำแหน่งอื่นในคณะกรรมการบริหารองค์การนักศึกษา ที่ดำรงตำแหน่งอยู่ก่อนวันที่ข้อบังคับนี้มีผลใช้บังคับ ให้ปฏิบัติหน้าที่ตามข้อบังคับนี้ต่อไปจนกว่าจะมีการแต่งตั้งคณะกรรมการบริหารองค์การนักศึกษาชุดใหม่"}]]]}]
184:["$","p","331",{"id":"clause-93","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$1","0",{"children":"ข้อ ๙๓"}]]}],["$","$1","1",{"children":" ให้คณะกรรมการนักศึกษาคณะที่มีอยู่ก่อนวันที่ข้อบังคับนี้มีผลใช้บังคับ ปฏิบัติหน้าที่เป็นคณะกรรมการนักศึกษาคณะตามข้อบังคับนี้"}]]]}]
185:["$","p","332",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"และให้ประธานและกรรมการในคณะกรรมการนักศึกษาคณะ และตำแหน่งอื่นในคณะกรรมการนักศึกษาคณะ ที่ดำรงตำแหน่งอยู่ก่อนวันที่ข้อบังคับนี้มีผลใช้บังคับให้ปฏิบัติหน้าที่ตามข้อบังคับนี้ต่อไปจนกว่าจะมีการแต่งตั้งคณะกรรมการนักศึกษาคณะชุดใหม่"}]]]}]
186:["$","p","333",{"id":"clause-94","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$1","0",{"children":"ข้อ ๙๔"}]]}],["$","$1","1",{"children":" ให้ชุมนุมชมรมกิจกรรมนักศึกษาที่จัดตั้งขึ้นตามข้อบังคับ ระเบียบ หรือประกาศของมหาวิทยาลัยเดิม ดำเนินการตามข้อ ๖๓ เพื่อจัดทำร่างระเบียบชุมนุมตามข้อบังคับนี้ให้แล้วเสร็จภายในสี่สิบห้าวันนับแต่วันที่ข้อบังคับนี้มีผลใช้บังคับ เพื่อเสนอต่อนายกองค์การนักศึกษาเพื่อให้คณะกรรมการบริหารองค์การนักศึกษาพิจารณาตรวจสอบและเสนอขออนุมัติต่อสภานักศึกษาต่อไป"}]]]}]
