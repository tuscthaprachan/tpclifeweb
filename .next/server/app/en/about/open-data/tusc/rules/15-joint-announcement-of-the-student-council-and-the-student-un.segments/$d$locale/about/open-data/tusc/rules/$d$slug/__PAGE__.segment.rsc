43:["$","p","18",{"id":"clause-3","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 3"}]]}],["$","$3","1",{"children":" ประกาศนี้ให้ใช้บังคับแก่การดำเนินหรือจัดกิจกรรมประเภทเชียร์และคฑากรทั้งปวงภายในมหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ทุกกิจกรรม ไม่ว่าจัดขึ้นโดยองค์กรนักศึกษา กลุ่มกิจกรรมนักศึกษา หรือกลุ่มคณะบุคคลใดที่มีส่วนเกี่ยวข้องกับนักศึกษาไม่ว่าทางตรงหรือทางอ้อม"}]]]}]
44:["$","p","19",{"id":"clause-4","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$3","0",{"children":"ข้อ 4"}]]}],["$","$3","1",{"children":" ให้คณะกรรมาธิการวิสามัญที่ได้รับมอบหมาย ซึ่งแต่งตั้งตามประกาศสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ เป็นผู้ใช้อำนาจตามประกาศฉบับนี้"}]]]}]
45:["$","p","20",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"โดยคณะกรรมาธิการตามวรรค 1 เป็นผู้ใช้อำนาจตามแห่งระเบียบกิจกรรมนักศึกษามหาวิทยาลัยธรรมศาสตร์ ว่าด้วยการป้องกันการดำเนินกิจกรรมอันมีลักษณะเข้าข่ายการโซตัส การใช้อำนาจนิยมและการเลือกปฏิบัติ พ.ศ. 2568 โดยให้มีหน้าที่กำกับดูแล ติดตาม ตรวจสอบ และควบคุมการดำเนินกิจกรรมให้เป็นไปตามข้อบังคับ ระเบียบ และประกาศที่เกี่ยวข้อง"}]]]}]
