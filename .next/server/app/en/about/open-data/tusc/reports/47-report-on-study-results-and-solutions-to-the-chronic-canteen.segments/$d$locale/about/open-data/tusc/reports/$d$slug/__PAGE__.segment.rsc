ce:["$","p","131",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ยังคงอยู่ในระดับสูง ผู้ประกอบการจึงจำเป็นต้องปรับราคาจำหน่ายอาหารให้สูงขึ้นเพื่อรักษาสมดุลทางธุรกิจ ซึ่งในที่สุดภาระดังกล่าวก็ตกอยู่กับนักศึกษาและผู้ใช้บริการที่ต้องรับผิดชอบค่าอาหารในราคาที่สูงกว่าความเป็นจริง"}]]]}]
