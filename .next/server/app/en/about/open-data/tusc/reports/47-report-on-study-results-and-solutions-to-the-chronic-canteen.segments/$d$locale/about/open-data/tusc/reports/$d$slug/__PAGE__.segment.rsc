ee:["$","p","163",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"ในระยะเร่งด่วน เสนอให้ออกหนังสือเวียนกำชับผู้ประกอบการทุกร้านให้ปฏิบัติตามมาตรฐานสุขาภิบาลอย่างเคร่งครัด โดยเฉพาะการบังคับให้ผู้สัมผัสอาหารสวมหมวกคลุมผม และการตรวจสอบความสะอาดของอุปกรณ์ทำความสะอาด เช่น ฝอยขัดหม้อและฟองน้ำ ไม่ให้ปนเปื้อนในอาหาร"}]]]}]
