10:["$","li","Works without JavaScript. Search, filters and page numbers work without JavaScript.",{"children":"Works without JavaScript. Search, filters and page numbers work without JavaScript."}]
11:["$","li","Motion. The site follows your device's reduce motion setting and supports forced colours mode.",{"children":"Motion. The site follows your device's reduce motion setting and supports forced colours mode."}]
12:["$","li","Language. Every page is available in Thai and English, and each page states its language correctly so screen readers pronounce it properly.",{"children":"Language. Every page is available in Thai and English, and each page states its language correctly so screen readers pronounce it properly."}]
13:["$","section",null,{"className":"flex flex-col","style":{"gap":"var(--space-2)"},"children":[["$","h2",null,{"children":"What does not meet the standard yet"}],["$","div",null,{"className":"prose [&>*+*]:mt-[var(--space-4)] [&_h2]:mt-[var(--space-8)] [&_h3]:mt-[var(--space-6)]","style":{"maxWidth":"var(--measure-en)"},"children":["$","ul",null,{"children":[["$","li","The TU91 student handbook was scanned from the printed book. We are retyping and laying it out again section by section, so some handbook pages are missing, or their headings and image descriptions have not been fully checked.",{"children":"The TU91 student handbook was scanned from the printed book. We are retyping and laying it out again section by section, so some handbook pages are missing, or their headings and image descriptions have not been fully checked."}],["$","li","Some forms are on other organisations' systems, such as Google Forms or a university system. This site tells you before you leave it, but cannot check or guarantee how accessible those systems are.",{"children":"Some forms are on other organisations' systems, such as Google Forms or a university system. This site tells you before you leave it, but cannot check or guarantee how accessible those systems are."}],["$","li","Images and files brought over from other sources, such as Instagram posts from TUSU and TUSC, may not all have image descriptions yet, because we are still adding this material.",{"children":"Images and files brought over from other sources, such as Instagram posts from TUSU and TUSC, may not all have image descriptions yet, because we are still adding this material."}],["$","li","This service is still in its alpha phase, as the banner at the top of every page says, so some information may be incomplete.",{"children":"This service is still in its alpha phase, as the banner at the top of every page says, so some information may be incomplete."}]]}]}]]}]
