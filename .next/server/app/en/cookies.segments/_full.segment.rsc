21:["$","section",null,{"className":"flex flex-col","style":{"gap":"var(--space-2)"},"children":[["$","h2",null,{"id":"$undefined","className":"$undefined","style":"$undefined","children":"Analytics"}],["$","div",null,{"className":"prose [&>*+*]:mt-[var(--space-4)] [&_h2]:mt-[var(--space-8)] [&_h3]:mt-[var(--space-6)]","style":{"maxWidth":"var(--measure-en)"},"children":["$","p",null,{"children":"This site does not use analytics or tracking tools. It does not count visitors, does not create an identifier that tracks you across visits or across other sites, and never uses your usage data for advertising."}]}]]}]
