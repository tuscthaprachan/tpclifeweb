{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/events/layout,_N_T_/[locale]/events/page,_N_T_/en/events,siteSettings,siteText,event,place,form,image"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/events/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  },
  "routeCache": {
    "key": "/route-cache/APP_PAGE/6e9ab8d5471f9a4dc49b800123dbd859b8d3cfbe5e4a35dda94e56a0e987fc35/$/en/events",
    "owner": {
      "kind": "APP_PAGE",
      "sourceRoute": "/[locale]/events/page"
    },
    "isFallback": false
  }
}