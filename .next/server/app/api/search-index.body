y"},"summary":{"th":"ชั้น 5 คณะรัฐศาสตร์","en":"5th floor, Faculty of Political Science"},"weight":20,"category":"welfare","path":"/th/directory#place-direk-jayanama-library"},{"id":"ba8725e7-56eb-43ff-b807-b01a244c2ffb","type":"place","title":{"th":"ห้องสมุดป๋วย อึ๊งภากรณ์","en":"Puey Ungphakorn Library"},"summary":{"th":"ชั้น 3 คณะเศรษฐศาสตร์","en":"3rd floor, Faculty of Economics"},"weight":20,"category":"welfare","path":"/th/directory#place-puey-ungphakorn-library-tha-prachan"},{"id":"31144ce9-4648-45fe-9bb5-a6e05691ee95","type":"place","title":{"th":"ห้องสมุด ศ.สังเวียน อินทรวิชัย","en":"Prof. Sangwian Indaravijaya Library"},"summary":{"th":"ชั้น 4 คณะพาณิชยศาสตร์และการบัญชี","en":"4th floor, Faculty of Commerce and Accountancy"},"weight":20,"category":"welfare","path":"/th/directory#place-sangwian-indaravijaya-library"},{"id":"beb0f110-c888-4499-a9c7-2e47207b7b00","type":"place","title":{"th":"ห้องสมุดคณะวารสารศาสตร์และสื่อสารมวลชน","en":"Faculty of Journalism and Mass Communication Library"},"summary":{"th":"","en":""},"weight":20,"category":"welfare","path":"/th/directory#place-journalism-library"},{"id":"1ce65480-0d78-4ae5-be87-6b0cbcc1081f","type":"place","title":{"th":"TU Virtual Clinic","en":"TU Virtual Clinic"},"summary":{"th":"ลานอนามัย ใต้อาคารกิจกรรมนักศึกษา ตรงข้ามโรงยิม","en":"Health courtyard, under the Student Activity Building, opposite the gym"},"weight":20,"category":"welfare","path":"/th/directory#place-tu-virtual-clinic"},{"id":"09e56380-eda1-4a85-914f-158ffde4b50d","type":"place","title":{"th":"ฟิตเนส ธรรมศาสตร์ท่าพระจันทร์","en":"Thammasat Tha Prachan fitness centre"},"summary":{"th":"ข้างอาคารยิมเนเซียม","en":"Beside the gymnasium"},"weight":20,"category":"activity","path":"/th/directory#place-tha-prachan-fitness"},{"id":"70f01bac-39e3-4ccc-b395-5f2ecfe87a16","type":"place","title":{"th":"ห้องสันทนาการนักศึกษา","en":"Student lounge"},"summary":{"th":"ชั้น 3 อาคารกิจกรรมนักศึกษา","en":"3rd floor, Student Activity Building"},"weight":20,"category":"activity","path":"/th/directory#place-student-lounge"},{"id":"d91ccf28-abd6-432b-a6cd-33364384e865","type":"place","title":{"th":"ศูนย์บริการคอมพิวเตอร์ ธรรมศาสตร์ท่าพระจันทร์","en":"Thammasat Tha Prachan Computer Service Center"},"summary":{"th":"บริเวณ 1 และ 2 อาคารยิมเนเซียม","en":"Areas 1 and 2, gymnasium building"},"weight":20,"category":"activity","path":"/th/directory#place-tha-prachan-computer-service-center"},{"id":"fdf31217-3e84-47cd-a65e-5d89048bf0b5","type":"place","title":{"th":"นิวย่งฮั้ว","en":"New Yong Hua"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-new-yong-hua"},{"id":"997d34db-4b67-441b-8125-1697514ca1f7","type":"place","title":{"th":"หม่าล่าหน้ามอ","en":"Mala Na Mor"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-mala-na-mor"},{"id":"dd257be8-bdd6-4412-a5c7-d5a98224751c","type":"place","title":{"th":"ป้าป้อมขนมโตเกียว","en":"Pa Pom Tokyo Snacks"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-pa-pom-tokyo"},{"id":"2628266b-118f-46d5-9195-f20e398d6259","type":"place","title":{"th":"ร้านอาหารอีสาน แซ่บอำหลำ","en":"Saep Am Lam Isan restaurant"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-saep-am-lam"},{"id":"6066b6d8-ac5a-409a-bec1-5eec939498bf","type":"place","title":{"th":"ร้านน้ำผลไม้","en":"The fruit juice shop"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-fruit-juice-shop"},{"id":"24f39119-493b-47b0-8a68-3429092bb620","type":"place","title":{"th":"LUA Café","en":"LUA Café"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-lua-cafe"},{"id":"d4d240ba-b22e-4c1d-8aa0-abfb0ea29fba","type":"place","title":{"th":"ช่างคั่ว สาขาธรรมศาสตร์ท่าพระจันทร์","en":"Chang Khua, Thammasat Tha Prachan"},"summary":{"th":"","en":""},"weight":20,"category":"activity","path":"/th/directory#place-chang-khua-tha-prachan"},{"id":"5e845e74-5aec-4838-9e4f-7a56a2b1afd4","type":"place","title":{"th":"โรงอาหาร อาคารธรรมศาสตร์ 60 ปี","en":"Thammasat 60th Anniversary Building canteen"},"summary":{"th":"","en":""},"weight":20,"category":"welfare","path":"/th/directory#place-thammasat-60-years-canteen"},{"id":"99851193-04e4-4858-aac3-afcb489461ce","type":"place","title":{"th":"หอสมุดปรีดี พนมยงค์","en":"Pridi Banomyong Library"},"summary":{"th":"","en":""},"weight":20,"category":"welfare","path":"/th/directory#place-pridi-banomyong-library"},{"id":"de40140b-c196-451f-a209-dfe977882bdc","type":"canonicalDish","title":{"th":"ข้าวราดแกง","en":"Curry over rice"},"summary":{"th":"ข้าวสวยหนึ่งจานราดแกงที่เลือกเองหนึ่งหรือสองอย่างจากหม้อหน้าร้าน ชี้เลือกได้เลย ไม่ต้องรู้ชื่อเมนู ราคาขึ้นอยู่กับจำนวนอย่าง","en":"A plate of rice with one or two curries or dishes of your choice from the pots at the counter."},"weight":45,"path":"/th/eat/what-is/khao-gaeng","haystack":"ข้าวราดแกง Curry over rice khao raad gaeng khao rad kaeng curry rice ข้าวแกง ข้าวสวยหนึ่งจานราดแกงที่เลือกเองหนึ่งหรือสองอย่างจากหม้อหน้าร้าน ชี้เลือกได้เลย ไม่ต้องรู้ชื่อเมนู ราคาขึ้นอยู่กับจำนวนอย่าง A plate of rice with one or two curries or dishes of your choice from the pots at the counter. You can simply point. The price depends on how many toppings you take."},{"id":"6703c765-36d2-4efe-93a0-8af6abf1fc27","type":"canonicalDish","title":{"th":"ข้าวผัด","en":"Fried rice"},"summary":{"th":"ข้าวสวยผัดกับไข่และเนื้อสัตว์ปรุงด้วยซีอิ๊วและน้ำมันหอย เสิร์ฟพร้อมแตงกวา มะนาวและพริกน้ำปลา","en":"Rice stir-fried with egg and your choice of meat, seasoned with soy and oyster sauce, served with cucumber, a lime wedge and chilli in fish sauce on the side."},"weight":45,"path":"/th/eat/what-is/khao-pad","haystack":"ข้าวผัด Fried rice khao phat khaopad fried rice ข้าวสวยผัดกับไข่และเนื้อสัตว์ปรุงด้วยซีอิ๊วและน้ำมันหอย เสิร์ฟพร้อมแตงกวา มะนาวและพริกน้ำปลา Rice stir-fried with egg and your choice of meat, seasoned with soy and oyster sauce, served with cucumber, a lime wedge and chilli in fish sauce on the side."},{"id":"192987bd-3957-41a2-97d9-f013aeae35cd","type":"canonicalDish","title":{"th":"ข้าวมันไก่","en":"Khao man gai, Hainanese chicken rice"},"summary":{"th":"ไก่ต้มหรือไก่ทอดเสิร์ฟกับข้าวที่หุงในน้ำมันไก่ น้ำจิ้มเต้าเจี้ยวรสเค็มหวาน และน้ำซุปใส กินง่าย เหมาะกับคนที่เพิ่งมาลองอาหารไทย","en":"Poached or fried chicken over rice cooked in chicken fat, with a salty-sweet fermented bean dipping sauce and a clear broth."},"weight":45,"path":"/th/eat/what-is/khao-man-gai","haystack":"ข้าวมันไก่ Khao man gai, Hainanese chicken rice khao man kai khaomangai chicken rice ข้าวมัน ไก่ต้มหรือไก่ทอดเสิร์ฟกับข้าวที่หุงในน้ำมันไก่ น้ำจิ้มเต้าเจี้ยวรสเค็มหวาน และน้ำซุปใส กินง่าย เหมาะกับคนที่เพิ่งมาลองอาหารไทย Poached or fried chicken over rice cooked in chicken fat, with a salty-sweet fermented bean dipping sauce and a clear broth. It is mild and easy, a good first Thai meal."},{"id":"25715b09-2674-42d0-83f0-8337fe5e45e9","type":"canonicalDish","title":{"th":"ข้าวหมกไก่","en":"Khao mok gai, Thai-style chicken biryani"},"summary":{"th":"ข้าวหุงกับเครื่องเทศและขมิ้น วางไก่ทอดหรือไก่ต้มไว้ด้านบน กินกับน้ำจิ้มรสเปรี้ยวและน้ำซุป เป็นอาหารมุสลิมที่พบได้ทั่วไป","en":"Rice cooked with spices and turmeric, topped with fried or poached chicken, eaten with a sour dipping sauce and a small bowl of broth."},"weight":45,"path":"/th/eat/what-is/khao-mok-gai","haystack":"ข้าวหมกไก่ Khao mok gai, Thai-style chicken biryani khao mok kai khaomokgai biryani ข้าวหมก ข้าวหุงกับเครื่องเทศและขมิ้น วางไก่ทอดหรือไก่ต้มไว้ด้านบน กินกับน้ำจิ้มรสเปรี้ยวและน้ำซุป เป็นอาหารมุสลิมที่พบได้ทั่วไป Rice cooked with spices and turmeric, topped with fried or poached chicken, eaten with a sour dipping sauce and a small bowl of broth. A staple of Thai Muslim cooking."},{"id":"10ccb1a0-687c-4102-af89-19c3bd6945e2","type":"canonicalDish","title":{"th":"ลาบ","en":"Larb, minced meat salad"},"summary":{"th":"เนื้อสับปรุงรสด้วยน้ำมะนาว น้ำปลา พริกป่นและข้าวคั่ว โรยสะระแหน่และต้นหอม เป็นอาหารอีสานที่กินกับข้าวเหนียวหรือผักสด","en":"Minced meat dressed with lime juice, fish sauce, chilli flakes and toasted rice powder, topped with mint and spring onion."},"weight":45,"path":"/th/eat/what-is/larb","haystack":"ลาบ Larb, minced meat salad laab larp lahb เนื้อสับปรุงรสด้วยน้ำมะนาว น้ำปลา พริกป่นและข้าวคั่ว โรยสะระแหน่และต้นหอม เป็นอาหารอีสานที่กินกับข้าวเหนียวหรือผักสด Minced meat dressed with lime juice, fish sauce, chilli flakes and toasted rice powder, topped with mint and spring onion. An Isan dish eaten with sticky rice or fresh vegetables."},{"id":"c15ae6a1-3fdb-44f3-8277-bc03d7aa9077","type":"canonicalDish","title":{"th":"ข้าวกะเพรา","en":"Pad kra pao, holy basil stir-fry over rice"},"summary":{"th":"ผัดกะเพราคือเนื้อสัตว์สับผัดกับใบกะเพรา พริกและกระเทียม ราดบนข้าวสวย มักเสิร์ฟพร้อมไข่ดาวกรอบ เป็นเมนูตามสั่งที่คนสั่งมากที่สุด","en":"Minced meat stir-fried with holy basil, chilli and garlic, served over rice and usually topped with a crispy fried egg."},"weight":45,"path":"/th/eat/what-is/pad-kra-pao","haystack":"ข้าวกะเพรา Pad kra pao, holy basil stir-fry over rice krapow kaprao gaprao kra pao pad kaprao กะเพา กระเพรา ผัดกะเพราคือเนื้อสัตว์สับผัดกับใบกะเพรา พริกและกระเทียม ราดบนข้าวสวย มักเสิร์ฟพร้อมไข่ดาวกรอบ เป็นเมนูตามสั่งที่คนสั่งมากที่สุด Minced meat stir-fried with holy basil, chilli and garlic, served over rice and usually topped with a crispy fried egg. It is the most ordered made to order dish."},{"id":"8381506c-53cc-4ae8-be92-db3170e807f8","type":"canonicalDish","title":{"th":"ผัดซีอิ๊ว","en":"Pad see ew, stir-fried wide noodles in soy sauce"},"summary":{"th":"เส้นใหญ่ผัดกับซีอิ๊วดำ ไข่ และผักคะน้า ได้กลิ่นไหม้อ่อนจากกระทะร้อน รสหวานเค็ม","en":"Wide rice noodles fried with dark soy sauce, egg and Chinese broccoli."},"weight":45,"path":"/th/eat/what-is/pad-see-ew","haystack":"ผัดซีอิ๊ว Pad see ew, stir-fried wide noodles in soy sauce pad si ew pad siew phat si io ผัดซีอิ้ว เส้นใหญ่ผัดกับซีอิ๊วดำ ไข่ และผักคะน้า ได้กลิ่นไหม้อ่อนจากกระทะร้อน รสหวานเค็ม Wide rice noodles fried with dark soy sauce, egg and Chinese broccoli. Smoky from a very hot wok, sweet and salty."},{"id":"eb837b5e-912b-4043-bd8f-bdea2b7bd84b","type":"canonicalDish","title":{"th":"ผัดไทย","en":"Pad Thai"},"summary":{"th":"เส้นจันท์ผัดกับซอสมะขาม ไข่ เต้าหู้และถั่วงอก โรยถั่วลิสงป่น กินกับมะนาวและกุยช่าย รสเปรี้ยวหวานเค็ม","en":"Rice noodles fried in a tamarind sauce with egg, tofu and bean sprouts, topped with crushed peanuts and served with lime and garlic chives."},"weight":45,"path":"/th/eat/what-is/pad-thai","haystack":"ผัดไทย Pad Thai phat thai padthai เส้นจันท์ผัดกับซอสมะขาม ไข่ เต้าหู้และถั่วงอก โรยถั่วลิสงป่น กินกับมะนาวและกุยช่าย รสเปรี้ยวหวานเค็ม Rice noodles fried in a tamarind sauce with egg, tofu and bean sprouts, topped with crushed peanuts and served with lime and garlic chives. Sweet, sour and salty."},{"id":"a69861b7-f440-4e7a-810e-6611e1face04","type":"canonicalDish","title":{"th":"ราดหน้า","en":"Rad na, noodles in thick gravy"},"summary":{"th":"เส้นใหญ่ผัดหรือเส้นหมี่กรอบราดน้ำเกรวี่ข้นจากแป้งมัน ใส่ผักคะน้าและเนื้อสัตว์ รสออกหวานมัน กินแล้วอุ่นท้อง","en":"Pan-fried wide noodles or crispy noodles under a thick, glossy gravy with Chinese broccoli and meat."},"weight":45,"path":"/th/eat/what-is/rad-na","haystack":"ราดหน้า Rad na, noodles in thick gravy rat na lad na rad nah เส้นใหญ่ผัดหรือเส้นหมี่กรอบราดน้ำเกรวี่ข้นจากแป้งมัน ใส่ผักคะน้าและเนื้อสัตว์ รสออกหวานมัน กินแล้วอุ่นท้อง Pan-fried wide noodles or crispy noodles under a thick, glossy gravy with Chinese broccoli and meat. Savoury and comforting."},{"id":"39d468a8-759e-458e-8a2e-95c26c1c920a","type":"canonicalDish","title":{"th":"บัวลอย","en":"Rice balls in coconut milk"},"summary":{"th":"ลูกแป้งข้าวเหนียวเคี้ยวหนึบในน้ำกะทิอุ่นรสหวานเค็ม ใส่ไข่หวานได้ เป็นของหวานไทยแบบดั้งเดิม","en":"Chewy glutinous rice balls in warm, lightly salted sweet coconut milk, with an optional sweet egg."},"weight":45,"path":"/th/eat/what-is/bua-loy","haystack":"บัวลอย Rice balls in coconut milk bua loi bualoy ลูกแป้งข้าวเหนียวเคี้ยวหนึบในน้ำกะทิอุ่นรสหวานเค็ม ใส่ไข่หวานได้ เป็นของหวานไทยแบบดั้งเดิม Chewy glutinous rice balls in warm, lightly salted sweet coconut milk, with an optional sweet egg. A traditional Thai dessert."},{"id":"1c428060-22b1-48a9-a801-534b428a9b03","type":"canonicalDish","title":{"th":"ก๋วยเตี๋ยว","en":"Rice noodle soup"},"summary":{"th":"เส้นข้าวในน้ำซุปร้อน เลือกเส้นได้ ได้แก่ เส้นเล็ก เส้นใหญ่ หมี่ขาว และบะหมี่ กินแบบน้ำหรือแบบแห้งก็ได้ ปรุงรสเองที่โต๊ะ","en":"Rice noodles in hot broth."},"weight":45,"path":"/th/eat/what-is/kuay-teow","haystack":"ก๋วยเตี๋ยว Rice noodle soup guay teow kuaitiao kway teow noodle soup ก๊วยเตี๋ยว เส้นข้าวในน้ำซุปร้อน เลือกเส้นได้ ได้แก่ เส้นเล็ก เส้นใหญ่ หมี่ขาว และบะหมี่ กินแบบน้ำหรือแบบแห้งก็ได้ ปรุงรสเองที่โต๊ะ Rice noodles in hot broth. You choose the noodle: thin, wide, vermicelli or egg noodle, soup or dry. You season it yourself at the table."},{"id":"43615b06-6cd9-4bd9-8384-e96b37c07007","type":"canonicalDish","title":{"th":"โจ๊ก","en":"Rice porridge"},"summary":{"th":"ข้าวต้มเละร้อน ๆ กินกับขิง ต้นหอมและไข่ลวก อาหารเช้าที่ย่อยง่าย","en":"Hot, smooth rice porridge with ginger, spring onion and a soft egg."},"weight":45,"path":"/th/eat/what-is/jok","haystack":"โจ๊ก Rice porridge joke jook congee ข้าวต้มเละร้อน ๆ กินกับขิง ต้นหอมและไข่ลวก อาหารเช้าที่ย่อยง่าย Hot, smooth rice porridge with ginger, spring onion and a soft egg. A gentle breakfast."},{"id":"81c58f23-d40c-4e5b-a381-31b7d7a452d7","type":"canonicalDish","title":{"th":"ส้มตำ","en":"Som tam, green papaya salad"},"summary":{"th":"สลัดมะละกอดิบตำกับพริก กระเทียม มะนาว น้ำปลาและน้ำตาลปี๊บ รสเปรี้ยว เค็มและหวาน กินคู่กับข้าวเหนียวและไก่ย่าง","en":"Shredded unripe papaya pounded with chilli, garlic, lime, fish sauce and palm sugar."},"weight":45,"path":"/th/eat/what-is/som-tam","haystack":"ส้มตำ Som tam, green papaya salad som tum somtam papaya salad ตำไทย สลัดมะละกอดิบตำกับพริก กระเทียม มะนาว น้ำปลาและน้ำตาลปี๊บ รสเปรี้ยว เค็มและหวาน กินคู่กับข้าวเหนียวและไก่ย่าง Shredded unripe papaya pounded with chilli, garlic, lime, fish sauce and palm sugar. Sour, salty and sweet, eaten with sticky rice and grilled chicken."},{"id":"29918fff-cf8b-45d9-88cd-fc01cf02d013","type":"canonicalDish","title":{"th":"ชาเย็น","en":"Thai iced tea"},"summary":{"th":"ชาอัสสัมเข้มข้นผสมนมข้นหวานและนมสด เสิร์ฟเย็นจัดบนน้ำแข็ง หวานมากตามมาตรฐาน","en":"Strong Assam tea sweetened with condensed milk and finished with milk, served over ice."},"weight":45,"path":"/th/eat/what-is/cha-yen","haystack":"ชาเย็น Thai iced tea cha yen thai tea chaa yen ชาอัสสัมเข้มข้นผสมนมข้นหวานและนมสด เสิร์ฟเย็นจัดบนน้ำแข็ง หวานมากตามมาตรฐาน Strong Assam tea sweetened with condensed milk and finished with milk, served over ice. Very sweet by default."},{"id":"bac99e9c-205a-4a0d-94bb-3655532f9045","type":"canonicalDish","title":{"th":"ไข่เจียว","en":"Thai omelette"},"summary":{"th":"ไข่ตีแล้วทอดในน้ำมันร้อนจนฟูกรอบ กินกับข้าวสวยและน้ำพริกหรือซอสพริก ใส่หมูสับได้","en":"Beaten eggs fried in plenty of hot oil until puffed and crispy at the edges, eaten over rice with chilli sauce."},"weight":45,"path":"/th/eat/what-is/khai-jiao","haystack":"ไข่เจียว Thai omelette kai jiew khai jeow thai omelet ไข่ตีแล้วทอดในน้ำมันร้อนจนฟูกรอบ กินกับข้าวสวยและน้ำพริกหรือซอสพริก ใส่หมูสับได้ Beaten eggs fried in plenty of hot oil until puffed and crispy at the edges, eaten over rice with chilli sauce. Often made with minced pork."},{"id":"8492dd2f-3db1-4bfa-8c39-230a33987ed7","type":"canonicalDish","title":{"th":"ต้มยำ","en":"Tom yum, hot and sour soup"},"summary":{"th":"ซุปเปรี้ยวหอมตะไคร้ ข่าและใบมะกรูด จะเป็นน้ำใสหรือน้ำข้นก็ได้ ใส่เป็นซุปถ้วยเดียว หรือใส่ในก๋วยเตี๋ยว","en":"A hot and sour soup scented with lemongrass, galangal and makrut lime leaf, clear or creamy."},"weight":45,"path":"/th/eat/what-is/tom-yum","haystack":"ต้มยำ Tom yum, hot and sour soup tom yam tomyum tom yum goong ซุปเปรี้ยวหอมตะไคร้ ข่าและใบมะกรูด จะเป็นน้ำใสหรือน้ำข้นก็ได้ ใส่เป็นซุปถ้วยเดียว หรือใส่ในก๋วยเตี๋ยว A hot and sour soup scented with lemongrass, galangal and makrut lime leaf, clear or creamy. Ordered as a bowl of soup or as the broth for noodles."},{"id":"abe4eeb3-f7d1-406e-86f2-9d0633ff3c4a","type":"canteenDish","title":{"th":"บราวนี่อัลมอนด์","en":"Almond brownie"},"summary":{"th":"ร้าน 17 49 บาท ตรวจเมื่อ 21 ตุลาคม 2569","en":"Stall 17, 49 baht, checked 21 October 2026"},"weight":35,"path":"/th/eat/dishes/17-almond-brownie","haystack":"บราวนี่อัลมอนด์ Almond brownie brauni almond แอมที Am Tea ของหวาน Desserts"},{"id":"d89e485c-be5c-4e5d-828b-13e37ac43bc0","type":"canteenDish","title":{"th":"ช็อกโกแลตนมอัลมอนด์กาแฟช็อกโกแลตชิป","en":"Almond milk chocolate with coffee and chocolate chips"},"summary":{"th":"ร้าน 5 70 บาท ตรวจเมื่อ 21 ตุลาคม 2569","en":"Stall 5, 70 baht, checked 21 October 2026"},"weight":35,"path":"/th/eat/dishes/5-almond-chocolate-coffeechochips","haystack":"ช็อกโกแลตนมอัลมอนด์กาแฟช็อกโกแลตชิป Almond milk chocolate with coffee and chocolate chips BM HEALTH CLUB BM Health Club เครื่องดื่ม Drinks"},{"id":"f8a5cab8-d305-4a9b-9e1c-d77868cfec77","type":"canteenDish","title":{"th":"ลาเต้นมอัลมอนด์ไมโลวิปชีส","en":"Almond milk latte with Milo and whipped cheese"},"summary":{"th":"ร้าน 5 85 บาท ตรวจเมื่อ 21 ตุลาคม 2569","en":"Stall 5, 85 baht, checked 21 October 2026"},"weight":35,"path":"/th/eat/dishes/5-almond-latte-milowhip-cheese","haystack":"ลาเต้นมอัลมอนด์ไมโลวิปชีส Almond milk latte with Milo and whipped cheese BM HEALTH CLUB BM Health Club เครื่องดื่ม Drinks"},{"id":"577a8e99-e093-4c87-b57f-429900b8f6eb","type":"canteenDish","title":{"th":"มัทฉะนมอัลมอนด์ไวท์มอลต์","en":"Almond milk matcha with white malt"},"summary":{"th":"ร้าน 5 55 บาท ตรวจเมื่อ 21 ตุลาคม 2569","en":"Stall 5, 55 baht, checked 21 October 2026"},"weight":35,"path":"/th/eat/dishes/5-almond-matcha-white-malt","haystack":"มัทฉะนมอัลมอนด์ไวท์มอลต์ Almond milk matcha with white malt BM HEALTH CLUB BM Health Club เครื่