f:["$","div",null,{"className":"mx-auto w-full px-[var(--gutter)]","style":{"maxWidth":"var(--width-narrow)"},"children":[["$","nav",null,{"aria-label":"เส้นทางหน้า","className":"py-[var(--space-2)] text-sm","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-2 text-ink-600","children":[["$","li","/",{"className":"flex items-center gap-2","children":[["$","$L9",null,{"href":"/th","className":"inline-flex min-h-[var(--target-min)] min-w-[var(--target-min)] items-center justify-center text-action","children":"หน้าแรก"}],["$","span",null,{"aria-hidden":"true","children":"/"}]]}],["$","li","แถลงการณ์การเข้าถึงเว็บไซต์",{"className":"flex items-center gap-2","children":[["$","span",null,{"aria-current":"page","className":"text-ink-900","children":"แถลงการณ์การเข้าถึงเว็บไซต์"}],false]}]]}]}],["$","div",null,{"className":"flex flex-col pb-[var(--space-8)] pt-[var(--space-2)]","style":{"gap":"var(--space-8)"},"children":[["$","div",null,{"className":"flex flex-col","style":{"gap":"var(--space-4)"},"children":[["$","h1",null,{"id":"$undefined","className":"$undefined","style":"$undefined","children":"แถลงการณ์การเข้าถึงเว็บไซต์"}],["$","div",null,{"className":"prose [&>*+*]:mt-[var(--space-4)] [&_h2]:mt-[var(--space-8)] [&_h3]:mt-[var(--space-6)]","style":{"maxWidth":"var(--measure-th)"},"children":["$","p",null,{"children":"เว็บไซต์ #ท้ายท่าพระจันทร์ (#trytpc) ตั้งเป้าให้เป็นไปตามมาตรฐาน WCAG 2.2 ระดับ AA หน้านี้บอกว่าส่วนใดเป็นไปตามมาตรฐานแล้ว ส่วนใดยังไม่เป็น และเพราะเหตุใด บริการนี้ยังอยู่ในช่วงทดลอง เนื้อหาและการใช้งานบางส่วนจึงยังไม่สมบูรณ์"}]}]]}],["$","section",null,{"className":"flex flex-col","style":{"gap":"var(--space-2)"},"children":[["$","h2",null,{"id":"$undefined","className":"$undefined","style":"$undefined","children":"ผลการตรวจสอบตามมาตรฐาน"}],["$","div",null,{"className":"prose [&>*+*]:mt-[var(--space-4)] [&_h2]:mt-[var(--space-8)] [&_h3]:mt-[var(--space-6)]","style":{"maxWidth":"var(--measure-th)"},"children":["$","p",null,{"children":"เว็บไซต์นี้เป็นไปตามมาตรฐาน WCAG 2.2 ระดับ AA บางส่วน หมายความว่ามีบางส่วนของเนื้อหาที่ยังไม่เป็นไปตามมาตรฐานทั้งหมด ดังรายการด้านล่าง"}]}]]}],["$","section",null,{"className":"flex flex-col","style":{"gap":"var(--space-2)"},"children":[["$","h2",null,{"id":"$undefined","className":"$undefined","style":"$undefined","children":"ส่วนที่เป็นไปตามมาตรฐานแล้ว"}],["$","div",null,{"className":"prose [&>*+*]:mt-[var(--space-4)] [&_h2]:mt-[var(--space-8)] [&_h3]:mt-[var(--space-6)]","style":{"maxWidth":"var(--measure-th)"},"children":["$","ul",null,{"children":[["$","li","Page structure. Every page has a link to skip to the main content, one main heading, subheadings in order, and a clearly separated header, main content and footer.",{"children":"โครงสร้างหน้า ทุกหน้ามีลิงก์ข้ามไปยังเนื้อหาหลัก มีหัวข้อหลักหนึ่งหัวข้อ เรียงหัวข้อย่อยตามลำดับ และแบ่งส่วนส่วนหัว เนื้อหาหลัก และส่วนท้ายอย่างชัดเจน"}],["$","li","Colour. Every pair of text and button colours is checked automatically for contrast each time the site is published. The brand orange, pink and lilac are used only as backgrounds, never as text on a light background.",{"children":"สี ทุกคู่สีของข้อความและปุ่มผ่านการตรวจอัตราส่วนความต่างของสีโดยอัตโนมัติทุกครั้งที่เผยแพร่เว็บไซต์ สีส้ม ชมพู และม่วงอ่อนของแบรนด์ใช้เป็นสีพื้นเท่านั้น ไม่ใช้เป็นสีตัวอักษรบนพื้นสว่าง"}],["$","li","Keyboard. Everything can be used with a keyboard alone, you can always see where the focus is, and the mobile menu closes with the Escape key and returns focus to the button that opened it.",{"children":"แป้นพิมพ์ ทุกฟังก์ชันใช้งานได้ด้วยแป้นพิมพ์อย่างเดียว เห็นตำแหน่งโฟกัสชัดเจนเสมอ และเมนูบนมือถือปิดได้ด้วยปุ่ม Escape โดยโฟกัสกลับไปที่ปุ่มเปิดเมนู"}],["$","li","Size of buttons and links. Buttons and links that are not inside a sentence are at least 24 by 24 pixels, and 44 by 44 pixels on a touchscreen.",{"children":"ขนาดปุ่มและลิงก์ ปุ่มและลิงก์ที่ไม่ได้อยู่ในประโยคมีขนาดอย่างน้อย 24x24 พิกเซล และ 44x44 พิกเซลบนหน้าจอสัมผัส"}],"$L1b","$L1c","$L1d"]}]}]]}],"$L1e","$L1f","$L20"]}]]}]
21:Te64,window["__TRYTPC_SITE_TEXT__"]={"overrides":{"ui.aboutWhyAim":{"en":"We want to change that. Our aim is simple: to make information easier to find, and to give life at Tha Prachan a central anchor, one place every student can come back to, whatever they need and whenever they need it.","th":"เราอยากเปลี่ยนเรื่องนี้ เป้าหมายของเราเรียบง่าย คือทำให้ข้อมูลหาได้ง่ายขึ้น และให้ชีวิตที่ท่าพระจันทร์มีศูนย์กลางที่มั่นคง เป็นที่ที่นักศึกษาทุกคนกลับมาได้เสมอ ไม่ว่าจะต้องการอะไรหรือเมื่อใด"},"ui.aboutWhyInvite":{"en":"This site belongs to the students it serves, and it will keep growing as we learn what you need. If something is missing, unclear or wrong, tell us.","th":"เว็บไซต์นี้เป็นของนักศึกษาที่ใช้งาน และจะเติบโตต่อไปตามสิ่งที่พวกคุณต้องการ หากมีอะไรขาดหาย ไม่ชัดเจน หรือไม่ถูกต้อง บอกเราได้เสมอ"},"ui.aboutWhyHeading":{"en":"Why we made it","th":"ทำไมเราจึงสร้างเว็บไซต์นี้"},"ui.aboutWhyProblem":{"en":"Life at Tha Prachan is full of things worth knowing: where to eat, how to get around, which form to fill in, what is on this week, and who to ask when something goes wrong. Too often that information is scattered across posts, chats and noticeboards, and finding it depends on knowing the right person.","th":"ชีวิตที่ท่าพระจันทร์มีเรื่องที่ควรรู้มากมาย ทั้งกินอะไรดี เดินทางอย่างไร ต้องกรอกแบบฟอร์มไหน สัปดาห์นี้มีกิจกรรมอะไร และเมื่อมีปัญหาควรถามใคร แต่ข้อมูลเหล่านี้มักกระจัดกระจายอยู่ตามโพสต์ แชต และบอร์ดประกาศ จนการหาข้อมูลให้เจอขึ้นอยู่กับว่ารู้จักคนที่ใช่หรือไม่"},"ui.aboutWhyTogether":{"en":"We believe the two bodies serve students better together than apart. Building one site between us means no student has to know which body looks after what. They only need to know to come here.","th":"เราเชื่อว่าสององค์กรทำงานร่วมกันได้ดีกว่าแยกกันทำ การสร้างเว็บไซต์นี้ด้วยกันทำให้นักศึกษาไม่ต้องรู้ว่าเรื่องไหนเป็นงานขององค์กรใด เพียงแค่รู้ว่าต้องมาที่นี่"},"ui.aboutMadeTogether":{"en":"This website is made together by TUSU Tha Prachan and TUSC Tha Prachan.","th":"เว็บไซต์นี้สร้างขึ้นร่วมกันโดย อมธ. ท่าพระจันทร์ และสภานักศึกษา ท่าพระจันทร์"}}};c:["$","html",null,{"lang":"th-TH","className":"Sc3cqG_variable Dh32Da_variable xOt-Uq_variable","suppressHydrationWarning":true,"children":[["$","head",null,{"children":[["$","script",null,{"dangerouslySetInnerHTML":{"__html":"(function(){try{var m=document.cookie.match(/(?:^|; )(?:trytpc_theme|tpclife_theme)=(light|dark)(?:;|$)/);if(m){var r=document.documentElement;r.setAttribute(\"data-theme\",m[1]);r.style.colorScheme=m[1]}}catch(e){}})()"}}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"try{if(!/(?:^|; )trytpc_js=/.test(document.cookie))document.cookie=\"trytpc_js=1; path=/; SameSite=Lax\"}catch(e){}"}}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"$21"}}]]}],["$","body",null,{"children":[["$","a",null,{"href":"#main-content","className":"visually-hidden-focusable fixed left-2 top-2 z-[var(--z-skiplink)] rounded-control bg-surface px-4 py-2 text-ink-900 outline-none","children":"ข้ามไปยังเนื้อหาหลัก"}],["$","$11",null,{"fallback":null,"children":["$","$L23",null,{}]}],["$","aside",null,{"aria-label":"อัลฟา","className":"border-b border-line","children":["$","div",null,{"className":"mx-auto w-full max-w-[var(--width-content)] px-[var(--gutter)] flex items-center gap-2 py-1 text-sm","children":[["$","strong",null,{"className":"shrink-0 rounded-pill bg-governance px-2 py-0.5 font-semibold uppercase text-ink-on-fill","children":"อัลฟา"}],["$","span",null,{"className":"min-w-0 text-ink-900 sm:hidden","children":"$L24"}],"$L25"]}]}],"$L26","$L27","$L28"]}]]}]
