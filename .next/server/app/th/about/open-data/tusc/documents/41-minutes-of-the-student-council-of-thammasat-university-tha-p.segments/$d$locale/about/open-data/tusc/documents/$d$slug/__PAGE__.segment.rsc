69:["$","p","38",{"className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$3","0",{"children":"คุณรัชพล สังวรธรรม ประธานสภานักศึกษาฯ ท่าพระจันทร์ กล่าวว่า จะหารือในสัดส่วนของกรรมาธิการเลยหรือไม่ และมีผู้ใดจะเสนอสัดส่วนของกรรมาธิการหรือไม่"}]]]}]
