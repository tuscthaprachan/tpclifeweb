65:["$","p","46",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"จากการติดตาม และตรวจสอบโครงการ TPC Loykrathong 2025 ทางคณะกรรมาธิการติดตามและตรวจสอบขององค์การนักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ได้ศึกษาข้อมูลและพบประเด็นปัญหาและข้อสังเกตที่สำคัญหลายประการ ซึ่งส่งผลต่อประสิทธิภาพและความราบรื่นของการดำเนินงาน โดยทางคณะกรรมาธิการติดตามและตรวจสอบองค์การนักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ได้เสนอข้อคิดเห็นเพื่อเป็นแนวทางในการปรับปรุงการจัดทำโครงการในอนาคต ดังนี้"}]]]}]
66:["$","p","47",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"ประเด็นแรก ขั้นตอนการเตรียมงานมีการวางแผนโดยรวมทำได้ดี และมีงบประมาณมากกว่าปีการศึกษา 2567 อย่างไรก็ตาม งบประมาณดังกล่าวยังไม่เพียงพอต่อการดำเนินงานจริง เนื่องจากสถานที่จัดงานบริเวณลานปรีดีพนมยงค์มีข้อจำกัดด้านโครงสร้างพื้นฐาน เช่น ไม่มีระบบไฟฟ้าที่เพียงพอ และมีสภาพพื้นที่ที่ไม่ได้รับการปรับปรุง ทำให้ต้องใช้งบประมาณเพิ่มเติมในการจัดการระบบแสงสว่างและความปลอดภัย"}]]]}]
67:["$","p","48",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"ประเด็นที่สอง ด้านการบริหารจัดการงบประมาณ พบปัญหาสำคัญคือการเบิกจ่ายงบประมาณจากมหาวิทยาลัยโดยทางองค์การนักศึกษาฯไม่ได้รับงบประมาณแต่อย่างใด ซึ่งปกติควรจะได้งบประมาณดังกล่าว 3 วันก่อนวันงานทั้งที่ได้ดำเนินการตามขั้นตอนระเบียบครบถ้วนแล้ว อีกทั้งประสบปัญหาการถอนตัวของผู้สนับสนุนเงินทุนส่งผลให้ต้องเร่งหาแหล่งเงินทุนเพิ่มเติม เพิ่มภาระค่าใช้จ่ายในการดำเนินงานและต้องใช้เครดิตส่วนตัวในการดำเนินงานเพื่อให้โครงการสามารถดำเนินต่อไปได้"}]]]}]
68:["$","p","49",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"ประเด็นเด็นที่สาม ด้านรูปแบบกิจกรรม พบข้อถกเถียงเกี่ยวกับการจัดประกวดนางนพมาศ โดยทางองค์การนักศึกษาฯ มีความเห็นว่าไม่ควรให้มหาวิทยาลัยภายนอกที่ไม่ได้มีส่วนร่วมในการสนับสนุนงานเข้าร่วมกิจกรรมนี้อีกในปีถัด ๆ ไป เนื่องจากมีการใช้งบประมาณสูงซึ่งสะท้อนถึงความไม่เหมาะสมในการจัดสรรทรัพยากร"}]]]}]
69:["$","p","50",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"ประเด็นสุดท้าย คือทางองค์การนักศึกษาฯ ต้องมีการเข้าชี้แจงรายละเอียดโครงการกับมหาวิทยาลัยในหลายขั้นตอนก่อนที่จะดำเนินการจัดกิจกรรม ส่งผลให้เกิดภาระด้านเอกสารและการประสานงานเพิ่มขึ้น โดยปัญหาหลักยังคงเป็นเรื่องการไม่สามารถเบิกจ่ายงบประมาณได้ตามกำหนดเวลา"}]]]}]
6a:["$","p","51",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"อย่างไรก็ตาม ในวันดำเนินงานจริงพบว่าการจัดงานเป็นไปอย่างราบรื่น ปัญหาในหน้างานมีไม่มากนัก ผู้สนับสนุนยังคงให้ความร่วมมือในระดับที่น่าพอใจ และมีคณาจารย์เข้าร่วมงานเป็นจำนวนมาก สะท้อนถึงความสำเร็จในด้านการประชาสัมพันธ์และการจัดการหน้างาน"}]]]}]
