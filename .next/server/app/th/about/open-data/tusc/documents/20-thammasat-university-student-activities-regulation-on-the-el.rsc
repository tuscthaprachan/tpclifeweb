5d:["$","p","38",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"ให้ประธานกรรมการการเลือกตั้งบันทึกเหตุนั้นไว้ในคำวินิจฉัยชี้ขาดแทนการลงลายมือชื่อของคณะกรรมการการเลือกตั้งผู้นั้น แต่ถ้าเป็นกรณีที่ประธานกรรมการการเลือกตั้งและกรรมการการเลือกตั้งอีกจำนวนหนึ่งไม่อาจลงมือชื่อได้ ให้กรรมการการเลือกตั้งเท่าที่เหลืออยู่เป็นผู้บันทึกเหตุนั้น"}]]]}]
