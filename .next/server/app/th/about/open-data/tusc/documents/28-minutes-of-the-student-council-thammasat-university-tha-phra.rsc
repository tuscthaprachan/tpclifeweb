72:["$","p","42",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณรัชพล สังวรธรรม ประธานในที่ประชุม กล่าวว่า จากข้อเสนอสัดส่วนกรรมาธิการ มีผู้ใดเห็นต่างหรือไม่ หากไม่มีผู้ใดเห็นต่างสรุปสัดส่วนกรรมาธิการ คือ พรรครีนิว ทีพีซี 6 คน พรรครีไลฟ์ ท่าพระจันทร์ 3 คน และ อมธ. ท่าพระจันทร์ 2 คน และ หลังจากนี้ประสงค์ให้แต่ละพรรคดำเนินการส่งตัวแทนจากสัดส่วนข้างต้น และดำเนินการคัดเลือกประธานกรรมาธิการในภายหลัง"}]]]}]
