5a:["$","ul","45",{"className":"m-0 flex list-none flex-col gap-[var(--space-1)] p-0","children":[["$","li","0",{"className":"whitespace-pre-line","children":[[1,". ",[["$","$3","0",{"children":"แจกเอกสารหรือวีดิทัศน์เกี่ยวกับการหาเสียงเลือกตั้งในพื้นที่มหาวิทยาลัย โดยเอกสารหรือวีดิทัศน์เกี่ยวกับการหาเสียงเลือกตั้งสามารถระบุชื่อ รูปถ่าย หมายเลขประจำของตัวผู้สมัคร ชื่อของพรรคนักศึกษา สัญลักษณ์ของพรรคนักศึกษา นโยบายของพรรคนักศึกษา คติพจน์ คำขวัญ หรือข้อมูลประวัติเฉพาะที่เกี่ยวกับตัวผู้สมัครหรือพรรคนักศึกษา"}]]],[]]}],["$","li","1",{"className":"whitespace-pre-line","children":[[2,". ",[["$","$3","0",{"children":"ใช้พาหนะต่าง ๆ ในการหาเสียงเลือกตั้ง หรือจัดสถานที่หรือเวทีเพื่อโฆษณาหาเสียงเลือกตั้งได้ ทั้งนี้ ให้ผู้สมัครและพรรคนักศึกษาแจ้งรายละเอียดให้คณะกรรมการทราบอย่างน้อยเจ็ดวันก่อนดำเนินการตามแบบที่คณะกรรมการกำหนด"}]]],[]]}],["$","li","2",{"className":"whitespace-pre-line","children":[[3,". ",[["$","$3","0",{"children":"ใช้เครื่องขยายเสียงเพื่อช่วยในการหาเสียงเลือกตั้ง"}]]],[]]}],["$","li","3",{"className":"whitespace-pre-line","children":[[4,". ",[["$","$3","0",{"children":"ปิดประกาศการโฆษณาหรือติดแผ่นป้ายการโฆษณาที่ยานพาหนะในการหาเสียงเลือกตั้ง สถานที่หรือเวทีเพื่อโฆษณาหาเสียงเลือกตั้งของผู้สมัครหรือพรรคนักศึกษา ทั้งนี้ ไม่อยู่ภายใต้บังคับเรื่องขนาด จำนวน สถานที่ และบุคคลที่ปรากฏในประกาศหรือแผ่นป้าย"}]]],[]]}]]}]
