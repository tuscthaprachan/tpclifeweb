61:["$","p","22",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คุณรัชพล สังวรธรรม ประธานสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ กล่าวว่า สืบเนื่องจากวันที่ 21 พฤษภาคม 2568 ที่ผ่านมา ทางสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ได้รับหนังสือร้องเรียนจากทางองค์การนักศึกษามหาวิทยาลัยธรรมศาสตร์ เกี่ยวกับกรณีนักศึกษาถูกละเมิดและ"}]]]}]
