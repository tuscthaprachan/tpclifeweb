da:["$","p","163",{"id":"$undefined","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","$1","0",{"children":"คณะอนุกรรมาธิการแต่ละคณะประกอบด้วยอนุกรรมาธิการมีจำนวนไม่เกินเจ็ดคน โดยให้ตั้งจากบุคคลที่เป็นกรรมาธิการในคณะนั้นมีจำนวนไม่น้อยกว่าสามคนของจำนวนอนุกรรมาธิการทั้งหมดและประธานคณะอนุกรรมาธิการต้องเป็นกรรมาธิการ จำนวนนอกจากนั้นให้ที่ประชุมคณะกรรมาธิการเลือกจากรายชื่อกรรมาธิการเสนอ"}]]]}]
