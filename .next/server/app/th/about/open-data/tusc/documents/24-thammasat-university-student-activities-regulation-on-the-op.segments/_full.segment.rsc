dc:["$","p","165",{"id":"clause-68","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$1","0",{"children":"ข้อ ๖๘"}]]}],["$","$1","1",{"children":" เมื่อคณะกรรมาธิการสามัญได้กระทำกิจการ พิจารณาสอบสวน หรือศึกษาเรื่องใด ๆ ตามอำนาจหน้าที่หรือตามที่สภามอบหมาย ให้คณะกรรมาธิการสามัญรายงานให้ประธานสภาทราบ ในการกระทำกิจการ พิจารณาสอบสวน หรือศึกษาเรื่องใด ๆ ต้องไม่เป็นเรื่องซ้ำซ้อนกับคณะกรรมาธิการอื่น  ในกรณีที่การกระทำนั้นเกี่ยวข้องกัน ให้เป็นหน้าที่ของประธานสภาที่จะต้องดำเนินการให้คณะกรรมาธิการสามัญที่เกี่ยวข้องกันทุกคณะร่วมกันดำเนินการ"}]]]}]
