fa:["$","p","195",{"id":"clause-79","className":"m-0 max-w-[var(--measure-th)] whitespace-pre-line","children":[[],[["$","strong","0",{"children":[["$","$1","0",{"children":"ข้อ ๗๙"}]]}],["$","$1","1",{"children":" ถ้าประธานสภาวินิจฉัยแล้วว่าการดำเนินงานใดเป็นเรื่องเร่งด่วนอย่างยิ่ง ให้คณะกรรมการบริหารสภาและคณะกรรมการประสานงานร่วมสภา มีมติเห็นชอบในไม่น้อยกว่าสองในสามของจำนวนกรรมการเท่าที่มีอยู่ของแต่ละคณะ โดยต้องแจ้งสมาชิกให้ทราบถึงเหตุผลและการดำเนินการดังกล่าว จึงจะถือว่าเป็นมติสภาโดยอนุโลม"}]]]}]
