6e:["$","div","35",{"id":"$undefined","className":"flex max-w-[var(--measure-th)] flex-col gap-[var(--space-1)] border-t border-line pt-[var(--space-3)]","children":[[],["$","p",null,{"className":"m-0","children":["$","strong",null,{"children":"คุณอนุชิต ไตรทิพย์ สมาชิกสภานักศึกษา พรรครีไลฟ์ ท่าพระจันทร์"}]}],["$","p",null,{"className":"m-0 whitespace-pre-line","children":[["$","$1","0",{"children":" กล่าวชี้แจงเพิ่มเติมว่า ในความเป็นจริงแล้ว TU สามารถตีความได้ว่า โรงเรียนเตรียมอุดมศึกษา เช่นกัน พร้อมทั้งกล่าวถึงประเด็นว่า บุคคลประเภทใดบ้างที่สามารถได้รับอนุญาตให้จำหน่ายได้ จากนั้นได้เสนอให้มีมาตรการกำหนดคุณสมบัติผู้จำหน่ายอย่างชัดเจน และเห็นว่าประกาศที่เผยแพร่บนสื่อสังคมออนไลน์ควรออกโดย มหาวิทยาลัย โดยตรงมากกว่าจาก อมธ. เพราะการสื่อสารในเชิงกฎหมายนั้นเป็นเรื่องสำคัญ"}]]}]]}]
