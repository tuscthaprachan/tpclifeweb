84:["$","h5","71",{"id":"item-6-1","className":"m-0 mt-[var(--space-6)] border-t border-line pt-[var(--space-3)]","children":[[],[["$","$3","0",{"children":"6.1 พิจารณาญัตติขอยกเลิกระเบียบกิจกรรมนักศึกษามหาวิทยาลัยธรรมศาสตร์ ว่าด้วยการดำเนินงานและการประชุมสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พ.ศ. 2565 และขอเสนอให้ความเห็นชอบ (ร่าง) ระเบียบกิจกรรมนักศึกษามหาวิทยาลัยธรรมศาสตร์ ว่าด้วยการดำเนินงานและการประชุมสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พ.ศ. 2569 (คุณภูมิรพี เป็นผู้เสนอ)"}]]]}]
85:["$","div","72",{"className":"flex max-w-[var(--measure-th)] flex-col gap-[var(--space-1)] border-t border-line pt-[var(--space-3)]","children":[[],["$","p",null,{"className":"m-0","children":["$","strong",null,{"children":"คุณภูมิรพี กัณฐ์ศว์ สมาชิกสภานักศึกษาฯ ท่าพระจันทร์ พรรคริเนิว ทีพีซี"}]}],["$","p",null,{"className":"m-0 whitespace-pre-line","children":[["$","$3","0",{"children":" กล่าวว่า ตามที่ สภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ ได้ถือปฏิบัติและดำเนินงานภายใต้ระเบียบกิจกรรมนักศึกษามหาวิทยาลัยธรรมศาสตร์ ว่าด้วยการดำเนินงานและการประชุมสภานักศึกษามหาวิทยาลัยธรรมศาสตร์ ท่าพระจันทร์ พ.ศ. 2565 มาเป็นระยะเวลาหนึ่งแล้วนั้น ปัจจุบันพบว่า บริบทของการดำเนินกิจกรรมนักศึกษา รูปแบบการประชุม ตลอดจนโครงสร้างการบริหารจัดการภายในสภานักศึกษาได้เปลี่ยนแปลงไปอย่างมีนัยสำคัญ ส่งผลให้บทบัญญัติ ขั้นตอน และกระบวนการทำงานที่กำหนดไว้ในระเบียบฉบับเดิมเกิดข้อขัดข้อง ไม่ครอบคลุมถึงสถานการณ์ปัจจุบัน และบางประการเป็นอุปสรรคต่อความคล่องตัวในการปฏิบัติหน้าที่ของ"}]]}]]}]
