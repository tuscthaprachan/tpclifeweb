{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/help/layout,_N_T_/[locale]/help/page,_N_T_/th/help,siteSettings,siteText,content,form"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/help/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  },
  "routeCache": {
    "key": "/route-cache/APP_PAGE/88f6d74c791fb848255a672c290add60fef74ef4c604d3cd0e4c14d8a4dc5be4/$/th/help",
    "owner": {
      "kind": "APP_PAGE",
      "sourceRoute": "/[locale]/help/page"
    },
    "isFallback": false
  }
}