      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 160,
                "slots": null
              }
            }
          }
        }
      }
    }
  },
  "routeCache": {
    "key": "/route-cache/APP_PAGE/7638739e4783d2f3178625a351c4803987c5b9d6940b9426f75297f7ee7ed9c7/$/th/search",
    "owner": {
      "kind": "APP_PAGE",
