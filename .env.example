# Sanity. Create a project at sanity.io/manage, then copy the values here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Read token for draft previews and the Live Content API. Viewer role is enough.
# Never commit a real token. On Vercel this is a project environment variable.
SANITY_API_READ_TOKEN=

# Write token, used by exactly one code path: the lost and found report form,
# which stores a student's report as an unpublished draft for an editor to
# approve. Editor role is enough. Server only, and never the read token above.
# Leave it empty and the report form says so plainly rather than accepting a
# report it cannot store; the rest of the site is unaffected.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that revalidates cached pages.
SANITY_REVALIDATE_SECRET=

# Canonical origin, used for hreflang, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob read-write token, for file storage (item photos, complaint evidence).
# Server only. Leave empty and the site builds; anything that stores a file says so.
BLOB_READ_WRITE_TOKEN=

# Resend API key for transactional email (sign-in codes, staff invites). Server only.
RESEND_API_KEY=

# Sender for transactional email, on a domain with SPF, DKIM and DMARC set up,
# e.g. "TryTPC <no-reply@mail.example.org>". Both this and the key are needed.
EMAIL_FROM=

# Neon Postgres connection string (pooled). Server only. Leave unset to build and
# run pages that do not use the database; anything that does will say it is missing.
# On Vercel the Neon integration sets this per preview branch.
DATABASE_URL=
