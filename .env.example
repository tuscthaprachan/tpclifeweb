# Database. Every page reads its content from Postgres.
#   pglite:memory      a throwaway Postgres inside the server process, migrated and
#                      seeded on first use. Nothing to install. Use it for local
#                      development, tests, CI and `next build`.
#   pglite:./.pglite   the same, kept in that directory so edits survive a restart
#                      (one process at a time, so not for `next build`).
#   postgres://...     a Neon pooled connection string, for real deployments. On Vercel
#                      the Neon integration sets this per preview branch. Server only.
# Leave it unset to build and run the pages that do not use the database; anything that
# does will say it is missing and the content pages show their empty states.
DATABASE_URL=pglite:memory

# Canonical origin, used for hreflang, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob, for file storage (item photos, complaint evidence). Set either the
# read-write token or the store id (auth via Vercel OIDC on Vercel). Server only.
# Leave both empty and the site builds; anything that stores a file says so.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Resend API key for transactional email. Optional: staff sign-in does not use email. Invitation
# and recovery links are always shown on screen for the admin to pass on, and are also emailed
# when this and EMAIL_FROM are set. Server only.
RESEND_API_KEY=

# Sender for transactional email, on a domain with SPF, DKIM and DMARC set up,
# e.g. "TryTPC <no-reply@mail.example.org>". Both this and the key are needed.
EMAIL_FROM=

# Set to 1 to print every email to the server log instead of sending it, even in
# production. Invitation and recovery links then appear in the logs, so leave it unset
# unless you want that.
EMAIL_LOG_ONLY=

# Secret Better Auth signs cookies and passkey challenges with. At least 32 random
# characters: `openssl rand -base64 32`. Server only. Changing it signs everyone out;
# passkeys keep working.
BETTER_AUTH_SECRET=

# Public origin of this deployment, no trailing slash, e.g. https://example.org or
# http://localhost:3000. Used for sign-in cookies, passkeys and the invitation and recovery
# links. Passkeys are bound to its hostname (the WebAuthn RP ID), so changing the host
# makes every existing passkey unusable. On Vercel previews it falls back to VERCEL_URL.
BETTER_AUTH_URL=
