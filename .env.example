# Database. Every page reads its content from Postgres.
#   pglite:memory      a throwaway Postgres inside the server process, migrated and
#                      seeded on first use. Nothing to install. Use it for local
#                      development, tests, CI and `next build`.
#   pglite:./.pglite   the same, kept in that directory so edits survive a restart
#                      (one process at a time, so not for `next build`).
#   postgres://...     a Neon pooled connection string, for real deployments. On Vercel
#                      the Neon integration sets this per preview branch. Server only.
# Leave it unset to build and run the pages that do not use the database; anything that
# does will say it is missing and the content pages show their empty states.
DATABASE_URL=pglite:memory

# Sanity Studio only. The public site no longer reads Sanity; these are needed to open
# /studio until it is removed, and by the legacy scripts in sanity/seed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Canonical origin, used for hreflang, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob read-write token, for file storage (item photos, complaint evidence).
# Server only. Leave empty and the site builds; anything that stores a file says so.
BLOB_READ_WRITE_TOKEN=

# Resend API key for transactional email (sign-in codes, staff invites). Server only.
RESEND_API_KEY=

# Sender for transactional email, on a domain with SPF, DKIM and DMARC set up,
# e.g. "TryTPC <no-reply@mail.example.org>". Both this and the key are needed.
EMAIL_FROM=

# Secret Better Auth signs cookies and encrypts authenticator secrets with. At least
# 32 random characters: `openssl rand -base64 32`. Server only. Changing it signs
# everyone out and invalidates enrolled authenticator apps.
BETTER_AUTH_SECRET=

# Public origin of this deployment, no trailing slash, e.g. https://example.org or
# http://localhost:3000. Used for sign-in cookies, passkeys and the links in invite emails.
# Passkeys are bound to its hostname. On Vercel previews it falls back to VERCEL_URL.
BETTER_AUTH_URL=

# Email domains allowed to sign in with a code, comma separated. Staff invites can
# target any domain. Defaults to dome.tu.ac.th,tu.ac.th when empty.
AUTH_ALLOWED_EMAIL_DOMAINS=dome.tu.ac.th,tu.ac.th
