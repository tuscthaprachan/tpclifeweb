# Database. Every page reads its content from Postgres.
#   pglite:memory      a throwaway Postgres inside the server process, migrated and
#                      seeded on first use. Nothing to install. Use it for local
#                      development, tests, CI and `next build`.
#   pglite:./.pglite   the same, kept in that directory so edits survive a restart
#                      (one process at a time, so not for `next build`).
#   postgres://...     a Neon pooled connection string, for real deployments. On Vercel
#                      the Neon integration sets this per preview branch. Server only.
# Leave it unset to build and run the pages that do not use the database; anything that
# does will say it is missing and the content pages show their empty states.
DATABASE_URL=pglite:memory

# Canonical origin, used for hreflang, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob, for file storage (item photos, complaint evidence). Set either the
# read-write token or the store id (auth via Vercel OIDC on Vercel). Server only.
# Leave both empty and the site builds; anything that stores a file says so.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Self-hosting (Plesk): store files on this server's disk instead of Vercel Blob. An absolute
# path outside the app folder, so deploys never remove it. When set, it wins over Blob.
STORAGE_DIR=
# Signs private file links when STORAGE_DIR is set. Falls back to BETTER_AUTH_SECRET.
STORAGE_SIGNING_SECRET=
# Set to "production" on the live self-hosted site (Vercel sets VERCEL_ENV itself).
SITE_ENV=

# Resend API key for transactional email. Resend is live and required in production: staff
# invitation and recovery links, and the status mails to people who gave an email address, are
# sent through it. Staff sign-in itself does not use email. Server only.
RESEND_API_KEY=

# Sender for transactional email, on a domain with SPF, DKIM and DMARC set up,
# e.g. "TryTPC <no-reply@mail.example.org>". Both this and the key are needed.
EMAIL_FROM=

# Optional address that replies go to, e.g. the service desk mailbox. Without it, replies go to
# the sender in EMAIL_FROM.
EMAIL_REPLY_TO=

# Set to 1 to print every email to the server log instead of sending it, even in
# production. Invitation and recovery links then appear in the logs, so leave it unset
# unless you want that.
EMAIL_LOG_ONLY=

# Secret Better Auth signs cookies and passkey challenges with. At least 32 random
# characters: `openssl rand -base64 32`. Server only. Changing it signs everyone out;
# passkeys keep working.
BETTER_AUTH_SECRET=

# Public origin of this deployment, no trailing slash, e.g. https://example.org or
# http://localhost:3000. Used for sign-in cookies, passkeys and the invitation and recovery
# links. Passkeys are bound to its hostname (the WebAuthn RP ID), so changing the host
# makes every existing passkey unusable. On Vercel previews it falls back to VERCEL_URL.
BETTER_AUTH_URL=

# Key that encrypts personal data (names, emails, phone numbers, LINE ids) in case contacts,
# AES-256-GCM. 32 random bytes, base64: `openssl rand -base64 32`. Server only. REQUIRED in
# production: without it anything that would store or show personal data fails with "This
# service is not available right now" and nothing is stored in the clear. Outside production
# a fixed public development key is used, with a warning. Losing the key makes stored
# personal data unreadable.
PII_ENCRYPTION_KEY=

# To rotate: move the old PII_ENCRYPTION_KEY value here (comma separate several), set a new
# PII_ENCRYPTION_KEY, deploy, re-encrypt the stored values (reencryptContacts in
# lib/cases/contacts.ts), then remove this. Decrypt only.
PII_ENCRYPTION_KEY_PREVIOUS=

# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to /api/cron/retention and /api/cron/complaints (daily,
# see vercel.json), which deletes personal data one year after a case closes. Any random string
# of at least 16 characters: `openssl rand -hex 32`. Server only. Without it the route is closed
# and nothing is ever deleted.
CRON_SECRET=
